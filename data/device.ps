% This file implements "device-level" operators
% which are independent of the actual device implementation.
% It also implements the Showpage Semantics behavior
% specified in the call to xpost_create().

//.internaldict /QUIET known { }{ (loading device.ps...\n)print } ifelse

(/image.ps) //.xpostsys /.loadmodule get exec  % image.ps implements device base classes
(/nulldev.ps) //.xpostsys /.loadmodule get exec  % nulldevice
(/pdfwrite.ps) //.xpostsys /.loadmodule get exec  % pdf device

% Mirror the device class dictionaries into privatedict, where the makers and
% the C drivers reach them, before the default device is made below. They stay
% in userdict too, for the load-time methods still to come, until .finalize
% replaces them with local copies in privatedict and drops the userdict anchors.
[ /.xpost_BBOX /.xpost_NULLDEV /.xpost_PGMIMAGE /.xpost_PPMIMAGE /.xpost_PBMIMAGE
  /.xpost_TIFFIMAGE /.xpost_PDFWRITE /.xpost_DSCWRITE /.xpost_SVGWRITE ]
{ dup userdict exch known
    { dup userdict exch get .privatedict 3 1 roll put }
    { pop } ifelse
} forall

%/newdefaultdevice load ==
newdefaultdevice % defined in xpost_interpreter.c:setlocalconfig()
                 % as similar to one of these:
%                /DEVICE 50 50 newPGMIMAGEdevice def
%loadxcbdevice   /DEVICE 400 300 newxcbdevice def
%loadwin32device /DEVICE 400 300 newwin32device def

%DEVICE {pop =} forall

DEVICE begin
    /defaultmatrix [ 1 0 0 -1 0 height ] def

    % override the class's scanline FillPoly with the compiled
    % rasterizer, except where the device declares it draws nothing:
    % rasterizing into the null device would burn the whole render
    % cost of a page to discard every span
    currentdict /NoOutput known not {
        /FillPoly //.internaldict /.fillpoly get def
        % grayscale array-of-strings devices (.xpost_PGMIMAGE) get the compiled
        % FillRect too; erasepage clears the page through it. Fetch the
        % value with get: some devices store nativecolorspace as an
        % executable name, which a bare reference would try to execute.
        currentdict /nativecolorspace get /DeviceGray eq {
            /FillRect //.internaldict /.fillrectgray get def
        } if
        % packed-integer rgb devices whose raster is a PS-level ImgData
        % array (PPMIMAGE) likewise -- .fillrectrgb writes those rows
        % directly, so a device that keeps its raster in a C buffer (bgr)
        % has no ImgData and stays on its own FillRect. Skip a device that
        % brought a compiled FillRect of its own (the png family) too.
        currentdict /nativecolorspace get /DeviceRGB eq {
            currentdict /ImgData known {
                currentdict /FillRect get type /operatortype ne {
                    /FillRect //.internaldict /.fillrectrgb get def
                } if
            } if
        } if
    } if
end

/flushpage {
    DEVICE /Flush known {
        DEVICE dup /Flush get exec
    } if
} bind def

.xpostsys /ShowpageSemanticsDict <<

    % XPOST_SHOWPAGE_DEFAULT
    0 {
        (----showpage----) =print flush
        [ {(%lineedit)(r)file}stopped cleartomark
        DEVICE /pagenumber
        2 copy known {
            2 copy get 1 add put
        }{
            1 put
        } ifelse
        erasepage
    } 

    % XPOST_SHOWPAGE_NOPAUSE
    1 {
        % don't do it.
        % do not pause right here.
    } 

    % XPOST_SHOWPAGE_RETURN
    2 {
        returntocaller
    }
>> put

/showpage {
    DEVICE dup /Emit get exec

    //.xpostsys /ShowpageSemanticsDict get ShowpageSemantics get exec
} bind def

/copypage {
    DEVICE dup /Emit get exec
    flushpage 

    (----copypage----) =print flush
    [ {(%lineedit)(r)file}stopped cleartomark

} bind def

//.internaldict /QUIET known { }{ (eof device.ps\n)print } ifelse
