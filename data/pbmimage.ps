//.internaldict /QUIET known { }{ (loading pbmimage.ps...)print } ifelse

% .xpost_PBMIMAGE: the bilevel sibling of the grayscale device. The page
% renders through the grayscale machinery it inherits and emission
% thresholds each row at half coverage, black where dark, packed
% most significant bit first as the portable bitmap format wants.

.privatedict /newPBMIMAGEdevice { % width height  .  IMAGE-device-dict
    .privatedict /.xpost_PBMIMAGE get dup /Create get exec
} put

/.xpost_PBMIMAGE .xpost_PGMIMAGE dup length 2 add dict copy def

% a bilevel page keeps its glyphs bilevel
.xpost_PBMIMAGE /TextAlphaBits 1 put

% every grey painted screens through the halftone in force
.xpost_PBMIMAGE /ScreenPaint true put

% What this device stores for a grey at a pixel. The screen in force
% ranks the pixels of a cell, the cell tiles the device plane, and a grey
% whitens the pixel it covers where it reaches the threshold under that
% pixel: the position picks the threshold, so what is stored varies from
% one pixel to the next as well as with the grey. The tiling is counted
% the same way on both sides of the origin, so it runs off the page as it
% runs across it.
%
% The base class takes a paint through here on its way to the row and
% takes a read of a pixel this device holds no storage for through here
% as well, so the page is read on the terms it was written on.
.xpost_PBMIMAGE /.screenpix { % c1 x y  .  c1' x y
    currentdict /.htcell known {
        2 copy                                      % c x y x y
        .hth mod dup 0 lt { .hth add } if .htw mul  % c x y x (y%h)*w
        exch .htw mod dup 0 lt { .htw add } if add  % c x y idx
        .htcell exch get                            % c x y thr
        4 -1 roll .unitclamp 256 mul 0.5 add cvi
        exch ge { 1 }{ 0 } ifelse                   % x y white?
        3 1 roll                                    % c' x y
    } if
} put

% emission thresholds and packs through the compiled row writer; the
% Emit dispatch itself is inherited
.xpost_PBMIMAGE /.writepage { % img file
    2 dict begin
    {/f /a}{exch def}forall
    a f //.internaldict /.writepbmrows get exec
    f (%stdout)(w)file ne {
        f closefile
    } if
    end
} put

//.internaldict /QUIET known { }{ (eof pbmimage.ps\n)print } ifelse
