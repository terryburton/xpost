%init.ps is run before systemdict is made readonly
%
%systemdict /ud userdict put %trigger backup error handler

%procedures in systemdict
/QUIET where { pop }{ (loading init.ps...\n) print } ifelse

%(35\n) print
%currentfile flushfile

systemdict begin % make these definitions in systemdict
true setglobal   % systemdict is global, so these allocations must be global

% .xpostsys -- the interpreter's private namespace. Internal helper procedures
% and their static tables live here, out of the names a program may use; only
% the dotted anchor name is visible and the helpers hide behind it. A GLOBAL
% dictionary anchored in userdict, populated once at build time; its mutable
% per-render state lives in .gscratch (below) instead.
%
% Convention -- a helper h is defined and called as:
%     .xpostsys /h { ... } put              % define
%     //.xpostsys /h get exec               % call
% The // freezes the private dictionary into the calling procedure at scan
% time, so a program cannot shadow it; the /h get resolves the helper at run
% time, which keeps recursion and forward references working. Helpers reach
% each other by the same call form.
currentglobal true setglobal
userdict /.xpostsys 400 dict put
setglobal
% privatedict -- the interpreter's private LOCAL machinery dictionary. Recorded
% in the context (where the collector roots it and C reaches it) but never placed
% on the dict stack, so a program can neither name nor enumerate its members. It
% is LOCAL because it holds local objects (the device class dictionaries, the
% graphics scratch and template, the wrapped-operator anchor procedures) that a
% global private dictionary may not hold. Reached from PostScript through the
% .privatedict operator.
currentglobal false setglobal
256 dict .setprivatedict
setglobal
% DATA_DIR, the directory the interpreter loads its .ps modules from, is set by
% the bootstrap into userdict before this file runs. Move it into privatedict so
% it does not sit among the program's names; the loader reaches it there.
userdict /DATA_DIR known {
    .privatedict /DATA_DIR userdict /DATA_DIR get put
    userdict /DATA_DIR undef
} if
% .gscratch returns the local scratch dictionary the machinery mutates each
% render (strokedict, caches, local resources); it is a LOCAL object the
% collector reclaims. A bound reference to the operator resists shadowing.
% Defined before any module loads.
currentglobal false setglobal
userdict /.gscratchdict 64 dict put
% .gscratchproc freezes the local scratch dictionary, so it is itself a local
% object and lives in userdict, where the operator table keeps it reachable; a
% global home would hold a local reference. Only the .gscratch operator that
% wraps it is a simple object fit for systemdict.
userdict /.gscratchproc [ //.gscratchdict ] cvx put
/.gscratch dup userdict /.gscratchproc get .wrapop def
setglobal

currentglobal true setglobal
% The private C operators live under dot-prefixed names. Near the end of
% graphics loading they are relocated out of systemdict into .internaldict, so
% a program sees only the standard operators in systemdict while a font program
% still reaches them through 1183615869 internaldict. The few operators fetched
% by name during graphics loading are seeded here first, before that pass.
userdict /.internaldict 256 dict put
[ /.fillpoly /.fillrectgray ]
{ dup systemdict exch get .internaldict 3 1 roll put } forall

% int  internaldict  dict
% the guarded accessor by which a font program reaches the private
% operators; the password is part of the language folklore
/internaldict {
    1183615869 eq { //.internaldict }{
        /internaldict cvx /invalidaccess signalerror
    } ifelse
} bind def

% Debug aids and the internal context-state markers are C operators, not part of
% the language, and must not sit in a program's lookup path. The machinery
% operators above are relocated near the end of graphics loading, once the bind
% pass has frozen the procedures that use them; these are graphics-independent
% and used by nothing, so they move into .internaldict here, during init, and are
% hidden whether or not graphics is ever loaded.
1 dict begin
[ /dumpnames /dumpvm /debugloadon /debugloadoff /breakhere
  /_i_am_zombie_ /_i_am_free_ ]
{ /nm exch def
    systemdict nm known {
        .internaldict nm systemdict nm get put
        systemdict nm undef
    } if
} forall
end
setglobal

% statusdict holds device/product status a program may change, so it is a local
% dictionary -- save and restore isolate a job's changes -- that systemdict names
% (copyudtosd), like $error, errordict and userdict. Ghostscript keeps statusdict
% local as well.
currentglobal false setglobal
userdict /statusdict <<
    /manualfeed false
    /product (Xpost)
>> put
setglobal

% the job server's dictionary. exitserver ends the encapsulated job,
% announces that permanent state may change, and execution continues
% with the definitions made so far outliving the job -- the idiom
% every driver prolog uses. xpost runs jobs unencapsulated, so
% announcing and unwinding the begun dictionary is the whole of it.
% serverdict is likewise a local dictionary named in systemdict.
currentglobal false setglobal
userdict /serverdict 2 dict put
serverdict /exitserver {
    pop
    (%%[ exitserver: permanent state may be changed ]%%\n) print flush
    currentdict serverdict eq { end } if
} put
setglobal

% concatenate two strings -- a pure global helper, so it lives in .xpostsys
currentglobal true setglobal
.xpostsys /.strcat { % a b  .  ab
    2 copy
    length exch length exch 1 index add % a b an bn+an
    string dup 0 6 -1 roll putinterval % b an str
    dup 4 2 roll exch putinterval % (ab)
} bind put
setglobal

% .loadmodule -- pull in one of the interpreter's own .ps files by name,
% factoring the "(/x.ps) //.xpostsys /.loadmodule get exec" idiom that appears throughout
% the machinery. In .xpostsys like every other helper, and global with it.
currentglobal true setglobal
.xpostsys /.loadmodule { % (/name.ps)  .  -
    .privatedict /DATA_DIR get exch //.xpostsys /.strcat get exec run
} bind put
setglobal

%% predefined in xpost_interpreter.c:setlocalconfig()
%%
%/DATA_DIR 
%    /PACKAGE_DATA_DIR dup where { %PACKAGE_DATA_DIR is passed from the config if is_installed is true
%        exch get
%    }{
%        pop
%        %EXE_DIR (/../../data) strcat
%        %(./data)  % if is_installed is false, and no PACKAGE_DATA_DIR is defined, look for ps data in CWD/data
%        false mark [
%            /WIN32 where { pop
%                (../../../data) %visual_studio/vc10/Debug
%            } if
%            (data) %repo root
%            (../../data) %src/bin
%            (../../../data) %visual_studio/vc10/Debug
%        ]
%        {
%            {
%                dup (/err.ps) strcat (r) file % false mark ... (DIR) file
%                pop counttomark 2 add 1 roll cleartomark pop true mark % (DIR) true mark
%            } stopped not { exit } if
%        } forall
%        cleartomark
%        not { () } if % none of the above, try CWD
%    } ifelse
%def

%(EXE_DIR =) print EXE_DIR print (\n) print
/QUIET where { pop }{ (DATA_DIR =) print .privatedict /DATA_DIR get print (\n) print } ifelse

%(1\n)print
%/product (Xpost) def % now an operator in xpost_op_misc.c
%/version (0) def % now an operator in xpost_op_misc.c
%/revision 0 def % now an operator in xpost_op_misc.c
/run { (r) file cvx exec } def
/Run { (\() print dup =print (\) run\n) print flush run } def

%(2\n)print
/=string 128 string def
% the scratch string serves every cvs in the machinery: as an operator
% pushing it, procedures binding as they load freeze the reference,
% and a program may take the name for itself. Anchor the pusher procedure in
% internaldict rather than systemdict so a program enumerating systemdict does
% not see it; .wrapop freezes the procedure into the =string operator, and
% internaldict keeps it alive thereafter.
.internaldict /.=stringproc [ //=string ] cvx put
/=string dup .internaldict /.=stringproc get .wrapop def
/=print {
    dup type /stringtype ne {
        //=string cvs
    } if
    print
} bind def
/=only //=print def

%(3\n)print
/= {
    //=print exec
    (\n) print
} bind def

%dumpnames dumpvm
%debugloadon

%(/err.ps)
%(.) [ {
%    (XPOSTDIR) getenv %env
%    exch pop exch pop
%} stopped {cleartomark} if
%exch strcat Run
%(../../data)

%(4\n)print
(/err.ps) //.xpostsys /.loadmodule get exec

%(5\n)print
/stack { count dup 1 add copy //= repeat pop } def

%(6\n)print
userdict begin
% ==
24 dict begin
/==dict currentdict def
    /rmargin 72 def
    /NL (\n) def

    /cvsprint {
        =string cvs tprint
    } def
    /tprint {
        dup length cp add rmargin gt {
            NL print
            /cp 0 def
        } if
        dup length cp add /cp exch def
        print
    } def
    /typeprint { dup type exec } def

    /arraytype {
        dup rcheck {
            1 dict begin
            /first true def
            dup xcheck /isproc exch def
            isproc { ({) }{ ([) } ifelse tprint
            { first { /first false def }{ ( ) tprint } ifelse typeprint } forall
            isproc { (}) }{ (]) } ifelse tprint
            end
        }{ pop (-array-) tprint } ifelse
    } def
    { cvsprint }
    dup /booleantype exch def
    dup /integertype exch def
    /realtype exch def

    /invalidtype { pop (@INVALID@) tprint } def
    /nulltype { pop (null) tprint } def
    /dicttype { pop (-dict-) tprint } def
    /filetype { pop (-file-) tprint } def
    /marktype { pop (-mark-) tprint } def
    /fonttype { pop (-font-) tprint } def
    /contexttype { pop (-context-) tprint } def

    /nametype {
        dup xcheck not {
            (/) tprint
        } if
        cvsprint
    } def

    /operatortype {
        (--) tprint
        =string cvs tprint
        (--) tprint
    } def

    /savetype {
        pop (-savelevel-) tprint
    } def

    % re-readable string escaping for ==: a byte becomes \\ \( \) for
    % those three, a named escape for the five control characters that
    % have one, its own character when printable, and \ddd octal
    % otherwise -- so the output scans back to the same string
    /.es1 1 string def
    /.es3 3 string def
    /.escbyte { % byte  .  -
        dup 92 eq { pop (\\\\) print }{
        dup 40 eq { pop (\\\() print }{
        dup 41 eq { pop (\\\)) print }{
        dup 10 eq { pop (\\n) print }{
        dup 13 eq { pop (\\r) print }{
        dup  9 eq { pop (\\t) print }{
        dup  8 eq { pop (\\b) print }{
        dup 12 eq { pop (\\f) print }{
        dup 32 ge 1 index 127 lt and {
            .es1 exch 0 exch put .es1 print
        }{
            (\\) print
            dup 64 idiv 48 add .es3 exch 0 exch put
            dup  8 idiv 8 mod 48 add .es3 exch 1 exch put
            8 mod 48 add .es3 exch 2 exch put
            .es3 print
        } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse } ifelse
    } def

    /stringtype {
        dup rcheck {
            (\() tprint
            { .escbyte } forall
            (\)) print
        }{
            pop (-string- ) tprint
        } ifelse
    } def

/==only {
    %traceon
    //==dict begin
        /cp 0 def
        { typeprint } stopped
    end            % pop ==dict whether typeprint succeeded or errored,
    { stop } if    % so an error inside == does not strand it on the
                   % dict stack; re-raise once the dict stack is clean
} end def % remove ==dict, installing == in userdict
/== { ==only (\n) print } def
/pstack { count dup 1 add copy //== repeat pop } def
end % back to systemdict


/execdict 6 dict def
execdict begin
    /quitflag false def
    /checkquit {
        //execdict /quitflag get
        { exit } if
    } def
    /execdepth 0 def
end

% initiate an interactive session with prompt
% a postscript 'executive' session
/start {
    currentglobal
    false setglobal
    {
        //.xpostsys /loadgraphics get exec
        //.xpostsys /.finalize get exec
    } stopped {
        (unable to load graphics)print
        handleerror
        pstack
        quit
    } if
    % shadow the `quit` operator with this procedure which checks
    % the depth of 'executive' nesting
    userdict /quit {
        %exit
        //execdict /quitflag true put
        $error /newerror false put
        stop
    } put
    setglobal

    /executive load stopped
    pop //quit % the operator
} def

% report a top-level job error the way a job server does: the standard
% error line (through handleerror), then -- only when an error really
% occurred, not on a normal quit -- the notice that the rest of the job
% is flushed to end of file. An interactive executive keeps going, so it
% reports without this line.
% in the private global namespace, reached by the start procedures below through
% a frozen reference, so it does not sit visible in systemdict
currentglobal true setglobal
.xpostsys /.handlejoberror {
    $error /newerror get
    handleerror
    { (%%[ Flushing: rest of job \(to end-of-file\) will be ignored ]%%\n)
      print flush } if
} put
setglobal

% execute postscript program from stdin, and handle errors,
% but do not assume an interactive session
/startstdin {
    {
        //.xpostsys /loadgraphics get exec
        //.xpostsys /.finalize get exec
    } stopped {
        (unable to load graphics)print
        quit
    } if
    {
        (%stdin) run
    } stopped {
        //.xpostsys /.handlejoberror get exec
    } if
    quit
} def

% execute postscript program from a named file, and handle errors.
/startfilename { % (filename)
    {
        //.xpostsys /loadgraphics get exec
        //.xpostsys /.finalize get exec
    } stopped {
        (unable to load graphics)print
        quit
    } if
    {
        (r) file cvx exec        % (filename) has stayed on the stack
        executive
    } stopped {
        //.xpostsys /.handlejoberror get exec
    } if
    quit
} def
%currentfile flushfile

% execute a postscript program from a file object, which may represent
% a stream with no associated "name".
/startfile { % file-object
    /QUIET where { pop }{ (startfile\n)print } ifelse
    {
        //.xpostsys /loadgraphics get exec
        //.xpostsys /.finalize get exec
    } stopped {
        (unable to load graphics)print
        quit
    } if
    {
        cvx exec        % the file object has stayed on the stack
    } stopped {
        //.xpostsys /.handlejoberror get exec
    } if
    quit
} def

% No-graphics start procedures, selected by --no-graphics. Each mirrors its
% graphics-loading counterpart above but runs .finalize alone, without
% loadgraphics: the interpreter is still locked down -- the language relocates
% into systemdict and the private namespaces are sealed and hidden -- while the
% graphics modules are never loaded. This exercises the path in which loadgraphics
% is genuinely optional, and lets a program that needs no graphics avoid the cost.
/startstdinnographics {
    { //.xpostsys /.finalize get exec } stopped {
        (unable to lock down interpreter)print
        quit
    } if
    {
        (%stdin) run
    } stopped {
        //.xpostsys /.handlejoberror get exec
    } if
    quit
} def

/startfilenamenographics { % (filename)
    { //.xpostsys /.finalize get exec } stopped {
        (unable to lock down interpreter)print
        quit
    } if
    {
        (r) file cvx exec        % (filename) has stayed on the stack
        executive
    } stopped {
        //.xpostsys /.handlejoberror get exec
    } if
    quit
} def

/startfilenographics { % file-object
    { //.xpostsys /.finalize get exec } stopped {
        (unable to lock down interpreter)print
        quit
    } if
    {
        cvx exec        % the file object has stayed on the stack
    } stopped {
        .rundied
        //.xpostsys /.handlejoberror get exec
    } if
    quit
} def

/prompt {
    (PS) print
    count dup 0 eq { pop } { (<) print //=print exec } ifelse
    //execdict /execdepth get {
        (>) print
    } repeat
    flush
} def

% User, system, and device parameters. The current* operators return a fresh
% dictionary of the present values; the set* operators apply the parameters they
% recognise from the supplied dictionary and ignore the rest. The stack limits
% mirror the interpreter's fixed capacities (XPOST_{OPER,DICT,EXEC}_STACK_LIMIT
% in xpost_interpreter.c) and cannot be changed.
currentglobal true setglobal
/.uparams << /VMReclaim 0 /VMThreshold 0 >> def
setglobal

/setdevparams { pop pop } def
/currentdevparams { pop 0 dict } def

/currentuserparams {
    << /MaxOpStack 1000000 /MaxDictStack 5000 /MaxExecStack 1000000
       /VMReclaim .uparams /VMReclaim get
       /VMThreshold .uparams /VMThreshold get >>
} def
/setuserparams {
    dup /VMReclaim known {
        dup /VMReclaim get
        dup .uparams /VMReclaim 3 -1 roll put
        vmreclaim
    } if
    dup /VMThreshold known {
        dup /VMThreshold get
        dup .uparams /VMThreshold 3 -1 roll put
        setvmthreshold
    } if
    pop
} def

/currentsystemparams {
    << /RealFormat (IEEE) /ByteOrder true /MaxFontCache 1048576 >>
} def
/setsystemparams { pop } def

/setpagedevice {
    dup type /dicttype ne {
        /setpagedevice cvx /typecheck signalerror
    } if
    pop
} def
/currentpagedevice {
    <<
	/PageSize [ DEVICE /dimensions get aload pop ]
    >>
} def

% Move the start procedures into privatedict, off the dict stack: the C fetches
% them there (through ctx->privatedict) to prime a run, so a program never sees
% them among systemdict's names. They bind with the rest of privatedict in
% .finalize, before any program can shadow the operator names they call.
[ /start /startstdin /startfilename /startfile
  /startstdinnographics /startfilenamenographics /startfilenographics ]
{ dup systemdict exch known
    { dup dup systemdict exch get .privatedict 3 1 roll put systemdict exch undef }
    { pop } ifelse
} forall

end % systemdict

userdict begin
false setglobal

% executive is a global procedure in systemdict. It reaches $error by name,
% not with a frozen reference: $error is a name in systemdict for a dictionary
% in local VM, and a global procedure may not freeze a local object.
currentglobal true setglobal
/executive {
    //execdict begin

    /execdepth execdepth 1 add def
    /QUIET where { pop }{
        product print
        ( version ) print version print
        (.) print revision =print
        (\n) print
    } ifelse

    { %loop
        /quitflag false def
        $error /newerror false put
        /prompt load stopped {
            (Error during prompt execution\n) print
            handleerror
            exit
        } if
        {
            mark
            /stmtfile (%statementedit) (r) file def
        } stopped {
            cleartomark
            $error /newerror get {
                $error /errorname get
                /undefinedfilename ne { % ^d at prompt
                    handleerror
                } if
                $error /newerror false put
                exit
            } if
        }{
            pop stmtfile end
            {
                cvx exec
            } stopped //execdict begin {
                handleerror
                stmtfile closefile
            } if
        } ifelse
        checkquit
    } loop
    /quitflag false def
    //execdict /execdepth 2 copy get 1 sub put

    end
    $error /doclose false put
    stop
} bind
def
setglobal


(/qsort.ps) //.xpostsys /.loadmodule get exec

% (s1) (s2) (s3) ... (sN) n  ncat  (s1s2s3...sN)


% Named Resources
true setglobal
globaldict begin
/globalresourcedict <<
    /Category <<
        /Generic <<
            /DefineResource { % key instance 
            } % instance
            /UndefineResource { }
            /FindResource { }
            /ResourceStatus { }
            /ResourceForAll { }
            %/Category name % <filled-in by DefineResource>
            %/InstanceType typename % <optional>
            %/ResourceFileName { } % <optional>
        >>
    >>
    /ProcSet <<
    >>
>> def
end

false setglobal
.privatedict /localresourcedict <<
    /Encoding <<
        /StandardEncoding [ ]
        /ISOLatin1Encoding [ ]
    >>
>> put
true setglobal

% key instance category  defineresource  instance
/defineresource {
    %1. obtain catdict, the implementation for the category
    %2. catdict begin
    %3.   DefineResource
    %4. end

    /Category findresource
    begin
        DefineResource
    end

    %userdict /resourcesdict get
    %exch 2 copy known not {
    %    2 copy 5 dict put
    %} if
    %get
    %3 1 roll % d k i
    %readonly 
    %dup 4 1 roll % i d k i
    %get
} def

.privatedict /DIRSEP (/) put

% key category  findresource  instance
/findresource {
    dup /Category eq {
        globaldict /globalresourcedict get
    }{
    } ifelse
} def

    {
    /findresource {
        {   %attempt to load from dictionary
            currentglobal { % global vm mode: only check globaldict
                globaldict /globalresourcedict get % k c d
                1 index 2 copy known % k c d c b
            }{ % local vm mode: check userdict and globaldict
                .privatedict /localresourcedict get % k c d
                1 index 2 copy known % k c d c b
            } ifelse

            userdict /resourcedict get % k c d
            exch % k d c
            dup 4 1 roll % c k d c
            2 copy known not { % c k d c
                2 copy 5 dict put
            } if
            get % c k category
            exch % c cat k
            2 copy known not {stop} if
            get % c i
            exch pop % i
        } stopped {   %load from disk! % c cat k

            2 index dup length string cvs % c cat k (category)
            1 index dup length string cvx % c cat k (category) (key)
            .privatedict /DATA_DIR get (/Resources) //.xpostsys /.strcat get exec
            .privatedict /DIRSEP get 4 3 roll % c cat k (key) (Res)(/)(cat)
            .privatedict /DIRSEP get 5 4 roll % c cat k (Res)(/)(cat)(/)(key)
            (*) 6 ncat % c cat k (Res/cat/key*)
            [ exch
            {dup length string copy} 128 string filenameforall
            ] % [list-of-potential-resources]
            dup {gt} qsort % [sorted-list]
            0 get % greatest-sorted-key-match
            run
        } if
    } def
    } pop

%traceon
%debugloadon

currentglobal
false setglobal
% //.xpostsys /.fontsubstitutions get: findfont's substitute-face table, hidden in the private
% global namespace where a program cannot reach it
currentglobal true setglobal
.xpostsys /.fontsubstitutions <<
    /Times-Roman (Nimbus Roman No9 L)
    dup (URW Bookman L)

    /Courier (Liberation Mono)
    dup /FreeMono
    dup (Hershey\\-Plain\\-Triplex)
    dup (DejaVu Sans Mono)

    /Helvetica (DejaVu Sans)
    dup (Nimbus Sans L)

    /Palatino-Roman (URW Palladio L)
>> put
setglobal

% For the moment, we consider any fonts handled by FreeType to be Type 1.
% The FontDirectory will merely hold defined Type 3 fonts.
/FontDirectory
<<
>> def
setglobal

end % userdict

/findfont {
    FontDirectory 1 index known {
        FontDirectory exch get
    }{
        {   % try the operator
            //findfont
            dup /FontType 1 put
            dup /FontMatrix matrix put
            dup /Encoding 256 array put
            dup /BuildChar {} put
        } stopped { % operator failed: 
            //.xpostsys /.fontsubstitutions get exch 2 copy known { % try substitution
                get
                findfont % call proc (tail-)recursively 
            }{
                exch pop
                (no defined substitute for unfound font)=
                =
            } ifelse
        } if
    } ifelse
} def

%   /fontname size  selectfont  -
% /fontname matrix  selectfont  -
/selectfont {
    dup type /arraytype eq {
        exch findfont
        exch makefont
        setfont
    }{
        exch findfont
        exch scalefont
        setfont
    } ifelse
} def

% x y w h
currentglobal true setglobal   % a global .xpostsys helper
.xpostsys /rect { %ccw in device space
    dtransform 4 2 roll transform 4 2 roll
    dup 0 gt { neg 3 2 roll 1 index sub 3 1 roll } if
    1 index 0 lt { exch neg 4 3 roll 1 index sub 4 1 roll exch } if
    idtransform 4 2 roll itransform
    2 copy 6 2 roll
    moveto
    1 index 0 rlineto
    0 exch rlineto
    neg 0 rlineto
    lineto
} put
setglobal

% the painting pair works on its own path and leaves the caller's
% untouched; rectclip clips by the rectangles alone and clears the
% path, as the language specifies
/rectfill { gsave newpath //.xpostsys /rect get exec fill grestore } def
/rectstroke { gsave newpath //.xpostsys /rect get exec stroke grestore } def
/rectclip { newpath //.xpostsys /rect get exec clip newpath } def

% load graphics support. Global: the device-maker procedures baked into this
% body are global, matching the global .xpostsys their table installs into.
currentglobal true setglobal
.xpostsys /loadgraphics {
    systemdict /GRAPHICS_LOADED known { }{
        (/graphics.ps) //.xpostsys /.loadmodule get exec
    % Promote the procedure-implemented standard operators to real
    % operators: load answers operatortype for them and bind
    % substitutes them, so the classic self-redefinition idiom
    % /stroke { 1 2 scale stroke } bind def captures the standard
    % behaviour instead of recursing into itself. Only names holding
    % executable arrays promote; the procedures stay defed in
    % .wrappedprocs, keeping them inside the collector's view (the
    % operator table is outside it).
    graphicsdict /.wrappedprocs 128 dict put
    [
        /fill /eofill /stroke /strokepath /rectfill /rectstroke
        /clip /eoclip /initclip /rectclip /clippath
        /flattenpath /pathbbox /reversepath
        /show /ashow /widthshow /awidthshow /kshow /stringwidth /charpath
        /definefont /scalefont /makefont /setfont /findfont
        /setcachedevice /setcharwidth
        /setscreen /currentscreen /settransfer /currenttransfer
        /setgray /setrgbcolor /sethsbcolor /setcmykcolor /setcolor /setcolorspace
        /currentgray /currentrgbcolor /currenthsbcolor /currentcmykcolor
        /currentcolor /currentcolorspace
        /image /imagemask
        /showpage /copypage /erasepage
        /nulldevice /gsave /grestore /grestoreall /initgraphics
    ] {
        dup userdict exch known {
            dup userdict exch get
            dup type /arraytype eq 1 index xcheck and {
                % bind the procedure before wrapping it: a wrapped operator's
                % body is not reached by the later .bindscope pass, so freezing
                % its operator references (the get and exec of an internal
                % helper call, among the rest) has to happen here, or a program
                % that shadows an operator name reaches into the machinery.
                bind
                graphicsdict /.wrappedprocs get 2 index 2 index put
                1 index exch .wrapop
                userdict 3 1 roll put
            }{ pop pop } ifelse
        }{ pop } ifelse
    } forall
    } ifelse
} put

% The interpreter lockdown. Runs once, after loadgraphics has loaded whatever it
% is going to (or on its own if graphics is never loaded), when every helper the
% machinery needs has been defined. It freezes the machinery's operator
% references, relocates the language into systemdict and the private C operators
% into .internaldict, seals and hides the private namespaces, and returns the
% device classes to local VM. loadgraphics does the loading; this does the
% locking down -- so nothing unrelated to graphics is tied to loading it. The
% shared GRAPHICS_LOADED latch, set here, keeps both steps idempotent.
.xpostsys /.finalize {
    systemdict /GRAPHICS_LOADED known { }{
        % Open a writeable window on systemdict so the standard operators can be
        % relocated into it; the matching relock below closes it.
        .sysdictunlock
    % With the standard operators now operator-typed, freeze the
    % machinery's own references to them: bind substitutes an
    % operator wherever a name in a loaded procedure currently
    % resolves to one, so a program's later redefinition governs
    % what the program calls, never what the machinery calls.
    % Names holding procedures or dictionaries stay dynamic -- bind
    % passes them by. One level of dictionary descent reaches the
    % procedure tables: the wrapped implementations, the device
    % makers, the graphics state template, the error handlers.
    /.bindone { % value  .bindone  -
        dup type /arraytype eq 1 index xcheck and { bind } if pop
    } def
    /.bindscope { % dict  .bindscope  -
        dup { exch pop .bindone } forall
        { exch pop
            dup type /dicttype eq {
                { exch pop .bindone } forall
            }{ pop } ifelse
        } forall
    } def
    systemdict .bindscope
    userdict .bindscope
    % graphicsdict exists only once graphics has loaded; without it there is
    % nothing to bind and this step is simply skipped
    /graphicsdict where { pop graphicsdict .bindscope } if
    errordict .bindscope
    % the private helper namespace too, so a helper's own operator references
    % (the get and exec of //.xpostsys /h get exec, and everything else) freeze
    % and survive a program shadowing an operator name
    .xpostsys .bindscope
    % the mutable scratch holds procedure tables too (the stroke switch
    % handlers live inside strokedict); bind them so they survive a program
    % shadowing the operator names they call
    .gscratch .bindscope
    % privatedict holds machinery procedures too -- the gstate-template accessor,
    % the device class methods -- so bind them against a shadowed operator name
    % the same way. The anchor procedures moved here below were bound in userdict
    % before the move, so they carry their frozen references with them.
    .privatedict .bindscope

    % Move the standard operators from userdict into the unlocked systemdict,
    % leaving userdict for the program. Only global operator-valued names move;
    % the local error state, the font directories and the interactive helpers
    % stay. Machinery references to these names are already frozen (binding and
    % .bindscope over the loaded procedures), and a runtime lookup finds them
    % one dictionary further down the stack.
    [ userdict {
        exch dup type /nametype eq
        1 index 60 string cvs 0 get 46 ne and   % not a private dotted name
        % an operator, a bound procedure, or a standard array (the encodings)
        2 index dup xcheck exch type /arraytype eq or and
        2 index gcheck and
        { exch pop }{ pop pop } ifelse
    } forall ]
    dup { dup userdict exch get systemdict 3 1 roll put } forall
    { userdict exch undef } forall

    % userdict, errordict, $error and FontDirectory are names in systemdict for
    % local dictionaries; the userdict copies are dropped so each name resolves
    % in systemdict.
    [ /userdict /errordict /$error /FontDirectory /statusdict /serverdict ] {
        dup systemdict exch known { userdict exch undef }{ pop } ifelse
    } forall

    % Relocate the private C operators from systemdict into .internaldict. Every
    % machinery reference to them is now frozen -- the standard operators bound
    % above and .bindscope over the loaded procedures -- so a program
    % enumerating systemdict sees only the standard names, while a font program
    % reaches them through 1183615869 internaldict.
    [ systemdict {
        exch dup type /nametype eq
        2 index type /operatortype eq and
        { dup 60 string cvs 0 get 46 eq
          1 index /.sysdictunlock ne and
          1 index /.sysdictrelock ne and
          1 index /.gscratch ne and
          1 index /.privatedict ne and
        }{ false } ifelse
        { exch pop }{ pop pop } ifelse
    } forall ]
    dup { dup systemdict exch get .internaldict 3 1 roll put } forall
    { systemdict exch undef } forall
    % GRAPHICS_LOADED (the load latch) is program-facing, so it goes into
    % systemdict while it is still unlocked, where a program cannot remove or
    % overwrite it. USEDRAWLINE is an internal device-rendering flag read only by
    % the image devices, so it joins the relocated operators in .internaldict.
    systemdict /GRAPHICS_LOADED true put
    .internaldict /USEDRAWLINE true put
    .sysdictrelock
    userdict /.bindone undef
    userdict /.bindscope undef

    % Seal the private namespaces. They are fully populated now -- init and the
    % graphics modules have defined every helper, and the C operators have just
    % been relocated into .internaldict -- and the machinery only reads them
    % hereafter, always through a frozen // reference to the object. Freeze each
    % read-only so a program cannot overwrite a helper, and drop its userdict
    % anchor so a program cannot reach or even enumerate it. The frozen
    % references keep the objects alive and working; .gscratchdict stays writable
    % and anchored, as the machinery mutates it every render.
    userdict /.internaldict get readonly pop
    userdict /.xpostsys get readonly pop
    userdict /.internaldict undef
    userdict /.xpostsys undef

    % Return the device class dictionaries to local VM. setpagedevice records the
    % page geometry into them at run time, and that state must be subject to save
    % and restore -- a restore to before a setpagedevice reinstates the earlier
    % device -- so a job's page setup does not leak into the next. In local VM the
    % ordinary save/restore reverts those writes; a global home does not. (They
    % were local until the language moved into global VM and were swept along.)
    % Rebind each to a local copy in privatedict now that the device modules have
    % finished loading, with headroom for the parameters setpagedevice adds, and
    % drop the userdict anchor: the classes leave the program's namespace entirely
    % and the makers, the C drivers and setpagedevice reach them through
    % privatedict.
    currentglobal false setglobal
    [ /.xpost_BBOX /.xpost_NULLDEV /.xpost_PGMIMAGE /.xpost_PPMIMAGE /.xpost_PBMIMAGE
      /.xpost_TIFFIMAGE /.xpost_PDFWRITE /.xpost_DSCWRITE /.xpost_SVGWRITE ]
    { userdict 1 index known
        { dup userdict 1 index get dup length 16 add dict copy   % name name localcopy
          .privatedict 3 1 roll put                              % name (privatedict/name = localcopy)
          userdict exch undef }                                  % drop the userdict anchor
        { pop } ifelse
    } forall
    % Move the remaining local machinery anchors into privatedict as well: the
    % graphics scratch and the wrapped-operator anchor procedures. These are
    % reached only through frozen references and the operator table, both of
    % which the privatedict root keeps alive, so the objects move by reference
    % (no copy) and dropping the userdict anchor hides them without breaking a
    % thing.
    [ /.gscratchdict /.gscratchproc /.graphicsdictproc /.DEVICEproc /.error ]
    { dup userdict exch known
        { dup dup userdict exch get .privatedict 3 1 roll put userdict exch undef }
        { pop } ifelse
    } forall
    % the gstate-template dictionary is frozen into its accessor proc (already in
    % privatedict), so only its userdict anchor remains -- drop it
    userdict /.gstatetemplate known { userdict /.gstatetemplate undef } if
    setglobal

        % initgraphics needs a device, so it runs only when graphics has loaded;
        % locking down without graphics leaves no graphics state to initialise
        /graphicsdict where {
            pop
            /QUIET where { pop }{ (graphics loaded, calling initgraphics\n)print } ifelse
            initgraphics
        } if
    } ifelse
} put
setglobal

$error/initializing false put % ready to go!
false setglobal

% debug ps functions -- interpreter aids, not language operators, so private
currentglobal true setglobal
.xpostsys /doprompt {
    (\nbreak>)print flush
    (%lineedit)(r)file
    cvx {exec}stopped pop } put
.xpostsys /pause { //.xpostsys /doprompt get exec } put
setglobal

currentglobal true setglobal
.xpostsys /.dir {
    (*) { = } 128 string filenameforall
} put
setglobal

currentglobal true setglobal
.xpostsys /xpost {
    (Xpost is running. Type '(filename)run' to run a program.\n)print
} put
setglobal

(/prepr.ps) //.xpostsys /.loadmodule get exec  % use nifty preview prompt!

/QUIET where { pop }{ (eof init.ps\n)print } ifelse
%loadgraphics %called by start* procs
