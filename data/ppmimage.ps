//.internaldict /QUIET known { }{ (loading ppmimage.ps...)print } ifelse

.privatedict /newPPMIMAGEdevice { % width height  .  IMAGE-device-dict
    .privatedict /.xpost_PPMIMAGE get dup /Create get exec
} put

% .xpost_PPMIMAGE, the 24-bit rgb raster class: the shared raster method
% suite (.makerasterclass, image.ps) over three colour components per
% pixel, an integer row per scanline holding packed r<<16|g<<8|b, and
% emission as a raw (P6) portable pixmap. It uses the full range 0-255
% of values and does not calculate the actual maximum value in the data
% before transmitting; MaxVal is always 255.
%
% procedures (.xpost_PPMIMAGE is the Class dictionary, IMAGE an
% instance returned by Create):
%           width height .xpost_PPMIMAGE  Create  ->  IMAGE
%                 r g b x y IMAGE  PutPix  ->  -
%                       x y IMAGE  GetPix  ->  r g b
%         r g b x1 y1 x2 y2 IMAGE  DrawLine  ->  -
%    r g b x y width height IMAGE  DrawRect  ->  -
%    r g b x y width height IMAGE  FillRect  ->  -
%             r g b polygon IMAGE  FillPoly  ->  -
%                           IMAGE  Emit  ->  -
%                           IMAGE  Destroy  ->  -
%                           dict1  .copydict  dict2

/.xpost_PPMIMAGE <<
    /nativecolorspace /DeviceRGB
    /.ncomp 3
    /BlendPix //.internaldict /.blendpixrgb get

    % an integer row per scanline; fresh arrays hold nulls, so the rows
    % zero through the compiled helper
    /.rowalloc { width array } bind
    /.rowsinit { ImgData //.internaldict /.zerorows get exec } bind

    % what one .rowalloc costs the memory it allocates from, as the
    % elements and the string bytes it takes: an array row is one element
    % per pixel and no bytes. Create prices the whole raster from this
    % before it builds any of it.
    /.rowcost { % -  .  elements bytes
        width 0
    } bind

    % scale each component in [0,1] to a byte and pack; unpack to bytes
    /.packpix {
        .chan exch
        .chan 8 bitshift or exch
        .chan 16 bitshift or
    } bind
    /.unpackpix {
        dup -16 bitshift exch
        dup -8 bitshift 16#ff and exch
        16#ff and
    } bind

    % the rows unpack and stream through the compiled row writer
    /.writepage { % img file
        2 dict begin
        {/f /a}{exch def}forall
        a f //.internaldict /.writeppmrows get exec
        f (%stdout)(w) file ne {
            f closefile
        } if
        end
    } bind
>> //.xpostsys /.makerasterclass get exec def

/TESTGRAPHICS where {pop
    (TESTGRAPHICS ppmimage)=
    /dev 40 20 newPPMIMAGEdevice def
    .5 .5 .5 1 1 38 17 dev dup /DrawLine get exec
    .5 .5 .5 9 14 3 3 dev dup /FillRect get exec
    dev //.xpostsys /.transmitpage get exec
    pstack()=

} if

//.internaldict /QUIET known { }{ (eof ppmimage.ps\n)print } ifelse
