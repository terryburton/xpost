//.internaldict /QUIET known { }{ (loading resource.ps...)print } ifelse

% Level 2 resource machinery: named instances per category, held in
% global VM. /Category is itself a category whose instances are
% category implementation dictionaries: defining an instance there
% brings a new category into existence, which is how programs register
% private categories (typically copying /Generic as a starting point).
% On-disk resource storage is not implemented: resourceforall
% enumerates the defined instances only.
%
% The instance tables live in the private global namespace, out of a
% program's reach; only the operators below are public. Everything here
% is global, and global VM stays selected on return: the font machinery
% loaded next in init.ps is defined in global VM too.
true setglobal

.xpostsys /.resources 32 dict put
//.xpostsys /.resources get /Category 32 dict put
% the Generic category implementation: programs copy it to seed their
% own categories, so it need only exist and name itself
//.xpostsys /.resources get /Category get /Generic << /Category /Generic >> put

% A category is two things made together: a table of its own instances,
% and an implementation dictionary registered as an instance of
% /Category. A category with only one of them answers /Category
% resourcestatus and then raises undefinedresource the moment anything
% asks it for an instance, so neither half is written anywhere but here.

% name  .catinstances  -
% Give a category the table its instances live in, if it has not one
% already. This is the half both routes into existence share: the
% standard categories below, and a program defining an instance of
% /Category, which is how PLRM 3.9.2 has a program register a category
% of its own.
.xpostsys /.catinstances {
    //.xpostsys /.resources get exch 2 copy known
        { pop pop }{ 32 dict put } ifelse
} bind put

% name  .defcategory  -
% Bring a resource category into existence with an implementation
% dictionary that need only name the category it implements. A category
% that already exists is left alone, instances and all, which is what
% lets a module state the categories it keeps instances in without
% having to know whether another module has already asked for them.
.xpostsys /.defcategory {
    dup //.xpostsys /.resources get exch known { pop }{
        dup //.xpostsys /.catinstances get exec
        //.xpostsys /.resources get /Category get exch dup << /Category 3 -1 roll >> put
    } ifelse
} bind put

% the standard regular categories exist from the start, empty until
% instances are defined into them
[ /Font /CIDFont /CMap /FontSet /Encoding /Form /Pattern /ProcSet
  /ColorSpace /Halftone /ColorRendering /IdiomSet /Filter
  /ColorSpaceFamily /Emulator /ControlLanguage /Localization /PDL ]
{ //.xpostsys /.defcategory get exec } forall

% Directories searched, in order, when findresource misses in VM. Empty
% by default; the host appends entries (xpost_add_resource_dir, -I).
.privatedict /.resourcepath [] put

% category  .instof  instances
.xpostsys /.instof {
    //.xpostsys /.resources get exch 2 copy known not {
        pop pop /findresource cvx /undefinedresource signalerror
    } if
    get
} bind put

% instances defined in local VM live beside the global table and go
% away with restore, as the local dictionary holding them does
currentglobal false setglobal
.gscratch /.lresources 32 dict put
setglobal

% category  .linstof  instances
% the local table of a category, created on first use
.xpostsys /.linstof {
    .gscratch /.lresources get exch 2 copy known not {
        2 copy 8 dict put
    } if
    get
} bind put

% key instance category  defineresource  instance
/defineresource [ /anytype /anytype /nametype ] {
    dup /Category eq {
        % defining an instance of /Category is defining a category, so it
        % gets the table its instances will live in; the implementation
        % dictionary is the instance being defined
        2 index //.xpostsys /.catinstances get exec
    } if
    dup //.xpostsys /.instof get exec pop     % the category must exist either way
    currentglobal { //.xpostsys /.instof get exec }{ //.xpostsys /.linstof get exec } ifelse
    2 index 2 index put exch pop
} //.xpostsys /.defop get exec

% key category  .loadresource  bool
% On a findresource miss, try to load the named instance from the search
% path. Each directory is tried in order; the first file found is run in
% global VM -- so its defineresource lands in the shared instance table
% and persists across restore -- and the search stops. Returns whether a
% file was run.
.xpostsys /.loadresource {
    2 dict begin
    /category exch def
    /key exch def
    /loaded false def
    .privatedict /.resourcepath get {
        % dir
        category 128 string cvs
        key 128 string cvs
        .resourcefileopen {
            % execute the already-opened, confined file directly; running it
            % by name would reopen it outside the confined path
            currentglobal exch true setglobal cvx exec setglobal
            /loaded true def
            exit
        } if
    } forall
    loaded
    end
} bind put

% key category  findresource  instance
/findresource [ /anytype /nametype ] {
  { % loop, so the local-shadow path can exit early
    2 dict begin
    /category exch def
    /key exch def
    % ensure the category is defined. A category is itself an instance of
    % /Category, stored under Category/<name> in the resource layout, so a
    % reference to an as-yet-unloaded category loads its implementation.
    //.xpostsys /.resources get category known not {
        category /Category //.xpostsys /.loadresource get exec pop
    } if
    //.xpostsys /.resources get category known not {
        end /findresource cvx /undefinedresource signalerror
    } if
    % a local instance shadows a global one of the same name
    .gscratch /.lresources get category known {
        .gscratch /.lresources get category get dup key known
            { key get end exit }{ pop } ifelse
    } if
    category //.xpostsys /.instof get exec /instances exch def
    instances key known not {
        % miss: load the instance from the search path. The instance table
        % is shared, so a successful defineresource populates instances.
        key category //.xpostsys /.loadresource get exec not
        { end /findresource cvx /undefinedresource signalerror } if
        instances key known not
        { end /findresource cvx /undefinedresource signalerror } if
    } if
    instances key get
    end
    exit
  } loop
} //.xpostsys /.defop get exec

% key category  resourcestatus  status size true | false
/resourcestatus [ /anytype /nametype ] {
    % querying a category that does not exist is an undefined error (PLRM);
    % only a present-but-absent instance yields false. Ensure the category is
    % defined the same way findresource does before reporting on an instance.
    2 dict begin
    /category exch def
    /key exch def
    //.xpostsys /.resources get category known not {
        category /Category //.xpostsys /.loadresource get exec pop
    } if
    //.xpostsys /.resources get category known not {
        end /resourcestatus cvx /undefined signalerror
    } if
    key category
    end
    2 copy .gscratch /.lresources get exch 2 copy known {
        get exch known {
            pop pop 0 0 true
        }{
            //.xpostsys /.resources get exch 2 copy known not
                { pop pop pop false }
                { get exch known { 0 0 true }{ false } ifelse } ifelse
        } ifelse
    }{
        pop pop pop
        //.xpostsys /.resources get exch 2 copy known not
            { pop pop pop false }
            { get exch known { 0 0 true }{ false } ifelse } ifelse
    } ifelse
} //.xpostsys /.defop get exec

% key category  undefineresource  -
/undefineresource [ /anytype /nametype ] {
    2 copy .gscratch /.lresources get exch 2 copy known {
        get 1 index known {
            //.xpostsys /.linstof get exec exch undef pop
        }{
            pop pop //.xpostsys /.instof get exec exch undef
        } ifelse
    }{
        pop pop pop //.xpostsys /.instof get exec exch undef
    } ifelse
} //.xpostsys /.defop get exec

% string template  .wcmatch  bool
% Match a name against a resourceforall template: ? matches any one
% character, * any run (backtracking iteratively over the most recent
% star), and \ makes the following character literal.
.xpostsys /.wcmatch {
    8 dict begin
    /t exch def /s exch def
    /sl s length def /tl t length def
    /si 0 def /ti 0 def /star -1 def /smk 0 def
    /res null def
    { % loop
        si sl lt {
            /adv false def
            ti tl lt {
                t ti get dup 42 eq { % *
                    pop /star ti def /smk si def /ti ti 1 add def /adv true def
                }{
                    dup 92 eq ti 1 add tl lt and { % escaped literal
                        pop
                        t ti 1 add get s si get eq {
                            /ti ti 2 add def /si si 1 add def /adv true def
                        } if
                    }{
                        dup 63 eq exch s si get eq or { % ? or same character
                            /ti ti 1 add def /si si 1 add def /adv true def
                        } if
                    } ifelse
                } ifelse
            } if
            adv not {
                star 0 ge {
                    /ti star 1 add def
                    /smk smk 1 add def
                    /si smk def
                }{
                    /res false def exit
                } ifelse
            } if
        }{
            exit
        } ifelse
    } loop
    res null eq {
        { % loop: trailing stars match the empty remainder
            ti tl lt { t ti get 42 eq { /ti ti 1 add def }{ exit } ifelse }{ exit } ifelse
        } loop
        /res ti tl eq def
    } if
    res
    end
} bind put

% template proc scratch category  resourceforall  -
% Enumerate the category's instances whose names match the template,
% copying each name into scratch and calling proc with the substring.
% The keys are snapshotted first, so the proc may define or undefine
% resources; whether such changes are enumerated is unspecified, as
% the language allows.
/resourceforall [ /stringtype /proctype /stringtype /nametype ] {
    % merge the global table with any local instances over it
    dup //.xpostsys /.instof get exec exch
    .gscratch /.lresources get exch 2 copy known {
        get exch dup length 2 index length add 1 add dict
        exch { 2 index 3 1 roll put } forall
        exch { 2 index 3 1 roll put } forall
    }{ pop pop } ifelse
    5 dict begin
    /.rfinst exch def /.rfscr exch def /.rfproc exch def /.rftmpl exch def
    /.rfbuf 127 string def
    [ .rfinst { pop } forall ]
    {
        dup .rfbuf cvs .rftmpl //.xpostsys /.wcmatch get exec {
            % load, not lookup: a bare name would run the proc early
            .rfscr cvs /.rfproc load exec
        }{ pop } ifelse
    } forall
    end
} //.xpostsys /.defop get exec

% In-RIP trapping (PLRM 6.3). The trapping operators are defined in the
% Trapping procedure set; a program reaches them with
%   /Trapping /ProcSet findresource begin ... end
% The trapping parameter dictionary is not directly accessible: it is read and
% altered only through currenttrapparams and settrapparams. This interpreter
% keeps that parameter state and accepts trapping zones, but generates no traps
% -- a conformant answer for a device without in-RIP trapping.
currentglobal true setglobal
/Trapping <<
    % the cumulative trapping-parameter dictionary. The language prescribes no
    % default values (they are device-specific), so it starts empty.
    /.trapparams 15 dict
    % dict  settrapparams  -
    % merge a request dictionary's entries into the trapping parameters. The
    % effect is cumulative across calls; a key given a null value is set to
    % null (cancelled), an omitted key is left unchanged.
    /settrapparams {
        /settrapparams [ /dicttype ] //.xpostsys /.checkargs get exec
        { .trapparams 3 1 roll put } forall
    } bind
    % -  currenttrapparams  dict
    % return a dictionary reflecting the current trapping parameters
    /currenttrapparams {
        .trapparams dup length 1 add dict copy
    } bind
    % -  settrapzone  -
    % establish a trapping zone from the current path with the current
    % parameters; this device emits no traps, so nothing is produced
    /settrapzone { } bind
>> /ProcSet defineresource pop
setglobal

//.internaldict /QUIET known { }{ (eof resource.ps\n)print } ifelse
