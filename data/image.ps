//.internaldict /QUIET known { }{ (loading image.ps...\n)print } ifelse

% The raster device base classes. A raster class is one method suite --
% Create through Emit, the scanline plot machinery and the pixel
% accessors -- over a handful of parameters: the colour space, the
% number of colour components a paint delivers (.ncomp), how a scanline
% row is allocated and what it costs, how components store into a row
% and read back out of it, the coverage blender, and the page writer.
% .rasterproto holds the suite once; .makerasterclass builds a class
% from a parameter dictionary. The grayscale and rgb classes below are
% parameter files over this generator, and the bilevel and TIFF classes
% are dict-copies of those with the emission overridden.
%
% In the method comments, IMAGE is an instance returned by Create and
% c1..cN are the .ncomp colour components, each in [0,1].

(/qsort.ps) //.xpostsys /.loadmodule get exec

currentglobal true setglobal

.xpostsys /.rasterproto <<
    /dimensions [0 0]

    % glyph edges blend by coverage against what the page holds; the
    % interior takes the solid PutPix path
    /TextAlphaBits 4

    /.copydict //.xpostsys /.classcopydict get

    /Create { % width height IMAGE  .  IMAGE'
    begin {/height /width}{exch def}forall
    currentdict end
    dup /.copydict get exec
    begin
        % The rows of the page this device holds. A program may declare
        % the page's imaging bounding box (PLRM 6.2), asserting that it
        % paints no marks outside it; PLRM 6.2 leaves a device free to
        % render or to drop the marks that do fall outside, so the rows
        % the box does not reach need not be held at all and the page
        % shows the ground over them instead.
        %
        % The run of rows is left for this device by the page device
        % that is making it, and taken here. Taken, and not merely read:
        % a device that holds its page some other way never asks for it,
        % and the next device made must not inherit a box that was not
        % asked of it.
        graphicsdict /.rasterband 2 copy known {
            2 copy get 3 1 roll undef aload pop
        }{ pop pop 0 height } ifelse
        % A device that screens what it stores holds the whole page
        % whatever the box says. What such a device leaves for a grey is
        % a pattern that varies from one row to the next, and the single
        % ground row below cannot stand for the rows that are not held.
        currentdict /ScreenPaint known { pop pop 0 height } if
        /.bandrows exch def /.bandtop exch def
        % the run is held to the page, whatever named it
        .bandtop 0 lt .bandtop height ge or { /.bandtop 0 def } if
        .bandrows 1 lt { /.bandrows 1 def } if
        .bandtop .bandrows add height gt
            { /.bandrows height .bandtop sub def } if

        % raster memory is not part of VM (PLRM 3.7.3): allocate the
        % page buffer in global VM, which save and restore are defined not
        % to reach (PLRM 3.7.2, 3.7.3), so a mark made inside a save is
        % still on the page after the restore that ends it
        currentglobal true setglobal
        % The raster is priced before any of it is built: the ImgData
        % spine is one element per row of the page, each row held costs
        % what .rowcost says, and the whole extent is asked for at once.
        % A page held in part holds one row more, the one carrying the
        % ground the rest of the page shows. A page this interpreter
        % cannot hold is refused having taken nothing to be refused
        % with, where one built row by row until the memory ran out
        % would ask the system for everything it could get before
        % failing, and answer the same error at the end of it.
        height                      % spine elements
        .rowcost                    % spine rowelements rowbytes
        .bandrows .bandrows height lt { 1 add } if
                                    % spine rowelements rowbytes rows
        dup 3 1 roll mul            % spine rowelements rows bytes
        3 1 roll mul                % spine bytes elements
        3 -1 roll add               % bytes elements'
        exch                        % elements' bytes
        //.internaldict /.vmreserve get exec not {
            setglobal end
            /Create cvx /VMerror signalerror
        } if
        /ImgData height array def
        .bandtop 1 .bandtop .bandrows add 1 sub {
            ImgData exch .rowalloc put
        } for
        .bandrows height lt {
            % One empty row stands for every row the page does not hold.
            % It is a row of the class's own shape carrying no pixel, so
            % a mark landing on such a row is dropped where every other
            % out-of-page mark is dropped: against the row it was about
            % to be written to.
            /.emptyrow .rowempty def
            0 1 .bandtop 1 sub { ImgData exch .emptyrow put } for
            .bandtop .bandrows add 1 height 1 sub
                { ImgData exch .emptyrow put } for
            % The ground the rows the page does not hold show. It is a
            % row of the class's own shape, laid out as a row that is
            % held starts, and erasepage fills it in through /Ground
            % below.
            /.groundrow .rowalloc def
        } if
        setglobal
    currentdict
    end } bind

    /Destroy { % IMAGE  .  -
        pop
    } bind

    /.to-int { floor cvi } bind

    % c  .chan  byte
    % the one fold from a colour component to a stored 8-bit channel.
    % The clamp is not decoration: setgray and its siblings substitute
    % the nearest valid value (PLRM 8.2), but a Separation or DeviceN
    % tint transform is the program's own procedure and returns whatever
    % it computes, so a component outside [0,1] does reach here. Scaled
    % without it, 1.7 stores as 0.69 of full scale, the byte having
    % wrapped past the top of its range. Truncation, not rounding, is
    % what the compiled fills do, so a page painted through either lands
    % on the same byte.
    /.unitclamp { % c  .  c'
        dup 0 lt { pop 0 }{ dup 1 gt { pop 1 } if } ifelse
    } bind
    /.chan { % c  .  byte
        .unitclamp 255 mul cvi
    } bind

    /PutPix { % c1..cN x y IMAGE  .  -
    begin
        {
            .to-int exch .to-int exch
            dup 0 lt { stop } if
            dup height ge { stop } if
            1 index 0 lt { stop } if
            1 index width ge { stop } if
            ImgData exch get exch       % c1..cN row x
            .ncomp 2 add 2 roll         % row x c1..cN
            .rowput
        } stopped {
            .ncomp 2 add { pop } repeat
        } if
    end } bind

    /GetPix { % x y IMAGE  .  c1..cN
    begin
        .to-int exch .to-int exch
        ImgData exch get exch       % row x
        .rowget
    end } bind

    % The pixels a segment covers are the driver contract's (.linepix,
    % src/lib/xpost_dev_driver.h): the pixel centres the segment spans
    % along its major axis, clipped to the device. This method walks
    % them through PutPix; the window devices walk the same list through
    % their own plot. Neither states the rule.
    /DrawLine { % c1..cN x1 y1 x2 y2 IMAGE  .  -
    begin {y2 x2 y1 x1}{exch def}forall .takecolor
        /lp x1 y1 x2 y2 width height //.internaldict /.linepix get exec def
        0 2 lp length 2 sub {
            /li exch def
            .pushcolor lp li get lp li 1 add get currentdict PutPix
        } for
    end } bind

    %  -----|
    %  |    |
    %  |    |
    %  |-----
    /DrawRect { % c1..cN x y w h IMAGE  .  -
    begin {h w y x}{exch def}forall .takecolor
        0 1 h 1 sub {
            x 2 copy % h x h x
            exch y add .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
            w add
            exch y add 1 add .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
        } for
        1 1 w {
            x add y 2 copy % x+w y x+w y
            .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
            h add exch 1 sub exch
            .pushcolor .ncomp 2 add .ncomp roll currentdict PutPix
        } for
    end } bind

    % The rectangle a fill covers is the driver contract's (.rectspan,
    % src/lib/xpost_dev_driver.h): a negative extent reflects through
    % the origin and the far corner is inclusive, so an integral w gives
    % w+1 columns. This method walks the span through PutPix; the
    % compiled fills that replace it on a selected device, and the C
    % devices' own, take the same span from the same place. Nothing here
    % restates it, and nothing here has to agree with it by accident.
    /FillRect { % c1..cN x y w h IMAGE  .  -
    begin {h w y x}{exch def}forall .takecolor
        x y w h width height //.internaldict /.rectspan get exec {
            /ry1 exch def /rx1 exch def /ry0 exch def /rx0 exch def
            .pushcolor
            ry0 1 ry1 { % c1..cN y
                rx0 1 rx1 { % c1..cN y x
                    .ncomp 2 add copy exch % c1..cN y x c1..cN x y
                    currentdict PutPix % c1..cN y x
                    pop
                } for
                pop
            } for
            .ncomp { pop } repeat
        } if
    end } bind

    % expand a running device-space box to include a point; FillPoly
    % seeds minx/miny/maxx/maxy in the instance before the sweep
    /.maxmin { % x y
        2 copy
        dup maxy gt { /maxy exch def }{ pop } ifelse
        dup maxx gt { /maxx exch def }{ pop } ifelse
        dup miny lt { /miny exch def }{ pop } ifelse
        dup minx lt { /minx exch def }{ pop } ifelse
    } bind

    % x1 y1 x2 y2 x3 y3 x4 y4  .  x5 y5 true
    %                             false
    % segment intersection by translating A to the origin and rotating
    % AB onto the x axis; the scratch dictionary is preallocated once
    % for the whole suite, so the scanline sweep allocates nothing
    /.intersect {
		DICT
		begin
        {Dy Dx Cy Cx By Bx Ay Ax}{exch def}forall

        { %stopped
            % reject degenerate line
            Ax Bx eq Ay By eq and
            Cx Dx eq Cy Dy eq and or {stop} if

            % reject coinciding endpoints
            Ax Cx eq Ay Cy eq and
            Bx Cx eq By Cy eq and or
            Ax Dx eq Ay Dy eq and or
            Bx Dx eq By Dy eq and or {stop} if

            % translate by -Ax,-Ay
            /Bx Bx Ax sub def /By By Ay sub def
            /Cx Cx Ax sub def /Cy Cy Ay sub def
            /Dx Dx Ax sub def /Dy Dy Ay sub def

            % length of AB
            /distAB Bx Bx mul By By mul add sqrt def

            % rotate AB to x-axis
            /theCos Bx distAB div def
            /theSin By distAB div def
            /newX Cx theCos mul Cy theSin mul add def
            /Cy   Cy theCos mul Cx theSin mul sub def /Cx newX def
            /newX Dx theCos mul Dy theSin mul add def
            /Dy   Dy theCos mul Dx theSin mul sub def /Dx newX def

            % no intersection
            Cy 0 lt Dy 0 lt and Cy 0 ge Dy 0 ge and or {stop} if

            /ABpos Dx Cx Dx sub Dy mul Dy Cy sub div add def
            ABpos 0 lt
            ABpos distAB gt or {stop} if % intersection not on segment

            Ax ABpos theCos mul add
            Ay ABpos theSin mul add
        } stopped not

    end }
	dup 0 16 dict put
	bind

    %nb. this implementation is overridden as a device is finished
    %(the .completedevice step in device.ps)
    %see xpost_dev_generic.c:_fillpoly(ctx,poly,dev) for the
    %implementation in current use (10/8/2014)

    /FillPoly { % c1..cN polygon IMAGE  .  -
    begin {poly}{exch def}forall .takecolor

        /DEBUGFILL where { pop
            (\nFillPoly)=
            .pushcolor .ncomp 1 sub -1 0 { index =only( )=only } for
            .ncomp { pop } repeat
            poly ==
        } if

        /minx 16#7ffffff def
        /miny minx def
        /maxx minx neg def
        /maxy maxx def
        poly {
            dup type /arraytype eq {
                dup length 2 eq {
                    aload pop .maxmin
                }{
                    pop
                } ifelse
            }{
                pop
            } ifelse
        } forall

        /x_max width .5 add def

        /DEBUGFILL where { pop
            (FillPoly:<intersect polygon edges with scanlines>)=
        } if
        /P poly poly length 1 sub get def
        [
        poly {
            /Q exch def
            /DEBUGFILL where { pop
                (P=)=only P ==
                (Q=)=only Q ==
            } if
            x_max miny floor cvi .5 add % [ x_max miny+.5
            1                           % [ x_max miny+.5 1
            maxy ceiling cvi .5 sub     % [ x_max miny+.5 1 maxy-.5
            {                           % [ ... x_max y
                1 index exch            % [ ... x_max x_max y
                -.5 1 index               % [ ... x_max x_max y -.5 y
                4 2 roll
                P aload pop Q aload pop % [ ... x_max  x_max y  -.5 y  Px Py  Qx Qy
                .intersect {
                    2 array astore exch % [ ... [x y] x_max
                } if
            } for
            pop
            /P Q def
        } forall
        ]        % [list-of-x/y-intersections
        /DEBUGFILL where { pop
            dup ==()=
        } if

        /DEBUGFILL where { pop
            (FillPoly:<sort scanline intersection list>)=
        } if
        {
        dup { % comparitor  % [x1 y1] [x2 y2] . bool
            1 index 1 get
            1 index 1 get
            eq {            % y1 == y2
                exch 0 get
                exch 0 get
                lt             % (x1 < x2)
            }{              % y1 != y2
                exch 1 get
                exch 1 get
                lt             % (y1 < y2)
            } ifelse
        } //.xpostsys /qsort get exec   % [sorted-list-of-intersections]
        } pop
        dup .yxsort
        /DEBUGFILL where { pop
            dup ==()=
        } if

        /DEBUGFILL where { pop
            (FillPoly:<set pixels on each scanline>)=
        } if
        aload length 2 idiv { % repeat
            exch aload pop
            3 2 roll aload pop

            {
                //.internaldict /USEDRAWLINE known {
                    //.internaldict /USEDRAWLINE get {
                        .pushcolor .ncomp 4 add .ncomp roll
                        currentdict DrawLine
                        exit
                    } if
                } if

                pop                        % xa ya xb
                3 2 roll                   % ya xb xa
                exch 1 exch                % ya xa 1 xb
                dup width ge { pop width 1 sub } if
                { % for                    % ya x
                    .pushcolor .ncomp 1 add .ncomp roll % ya c1..cN x
                    .ncomp 1 add index     % ya c1..cN x ya
                    currentdict PutPix
                } for
                pop
            exit } loop

        } repeat

    end } bind %FillPoly

    % c1..cN  Ground  -
    % Take up the colour the page is being cleared to; PLRM 8.2 erases
    % the entire page, so this is the colour every row of it carries. A
    % page held in part shows it over the rows that are not held, and the
    % one row standing for those is laid in it here -- through .rowput,
    % the same store the fills reach, so the rows that are held and the
    % rows that are not come out the same colour.
    %
    % A sub-class holding its page some other way replaces Create and so
    % never records a run of rows. It holds the whole page, has no ground
    % to show, and drops the colour it is offered.
    /Ground { % c1..cN IMAGE  .  -
    begin
        currentdict /.bandrows known { .bandrows height lt }{ false } ifelse {
            0 1 width 1 sub {            % c1..cN x
                .groundrow exch          % c1..cN row x
                % the components stay for the next pixel, so the copy
                % this one stores is taken from where they lie
                .ncomp { .ncomp 1 add index } repeat
                .rowput
            } for
        } if
        .ncomp { pop } repeat
    end } bind

    % write the page: open the name settled for this page and hand the
    % rows to the class's .writepage
    /Emit { % IMAGE  .  -
    begin
        % The page a writer is given is the page the program asked for.
        % Where the device holds only the rows an imaging bounding box
        % reaches (PLRM 6.2), the rest of the page shows the ground, and
        % the whole page is put together here so that no writer has to
        % know the difference.
        .bandrows height lt {
            ImgData height array copy
            0 1 .bandtop 1 sub { 1 index exch .groundrow put } for
            .bandtop .bandrows add 1 height 1 sub
                { 1 index exch .groundrow put } for
        }{
            ImgData
        } ifelse
        .outputfile (w) file
        .writepage
    end } bind
>> put

% spec  .makerasterclass  class
% build a raster device class: the shared suite copied from
% .rasterproto, overlaid with the parameter dictionary, then completed
% with the colour take/push helpers the component count dictates.
% Load-time only.
.xpostsys /.makerasterclass { % spec  .  class
    //.xpostsys /.rasterproto get
    dup length 2 index length add 8 add dict
    copy
    exch { 2 index 3 1 roll put } forall
    dup /.ncomp get 1 eq {
        dup /.takecolor { /c1 exch def } put
        dup /.pushcolor { c1 } put
    }{
        dup /.takecolor { /c3 exch def /c2 exch def /c1 exch def } put
        dup /.pushcolor { c1 c2 c3 } put
    } ifelse
} bind put

setglobal

(/pgmimage.ps) //.xpostsys /.loadmodule get exec
(/pbmimage.ps) //.xpostsys /.loadmodule get exec
(/ppmimage.ps) //.xpostsys /.loadmodule get exec
(/tiffimage.ps) //.xpostsys /.loadmodule get exec

//.internaldict /QUIET known { }{ (eof image.ps\n)print } ifelse
