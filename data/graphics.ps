/QUIET where { pop }{ (loading graphics.ps...\n)print } ifelse

% fallback definitions so this file can run standalone; in the normal flow
% DATA_DIR lives in privatedict, so test for it there
.privatedict /DATA_DIR known {}{
    .privatedict /DATA_DIR {} put
    /strcat{1 1 index length 1 sub getinterval}def
    /breakhere{}def
}ifelse

true setglobal
userdict begin

    %/CONSTRAINFLATNESS null def

    % graphicsdict holds the live per-render graphics state -- currgstate and
    % the gstack of local gstate copies -- so it and its accessors stay in
    % local VM.
    currentglobal false setglobal
    /graphicsdict <<
        /currgstate 12 dict
        /gstackarray 100 array
        /gptr -1
    >> def
    % The machinery reaches its state dictionary and its device
    % through operators, promoted here before any machinery file
    % loads: every procedure binding as it loads freezes these
    % references, and a program may take either name for itself.
    % The implementation procedures anchor under reserved names so
    % the collector keeps them.
    .privatedict /.graphicsdict graphicsdict put   % the C operators' direct road in, off the dict stack
    /.graphicsdictproc [ //graphicsdict ] cvx def
    /graphicsdict dup /.graphicsdictproc load .wrapop def
    /.DEVICEproc { graphicsdict /currgstate get /device get } bind def
    /DEVICE dup /.DEVICEproc load .wrapop def
    setglobal

    %breakhere
    (/device.ps) //.xpostint /.loadmodule get exec %loads and uses (/image.ps)
    (/gstate.ps) //.xpostint /.loadmodule get exec
    %(/matrix.ps) //.xpostint /.loadmodule get exec % moved to xpost_op_matrix.c
    (/color.ps) //.xpostint /.loadmodule get exec
    (/path.ps) //.xpostint /.loadmodule get exec
    (/clip.ps) //.xpostint /.loadmodule get exec
    (/paint.ps) //.xpostint /.loadmodule get exec
    (/font.ps) //.xpostint /.loadmodule get exec
    (/pattern.ps) //.xpostint /.loadmodule get exec


% The binding pass below rebinds userdict and systemdict in place; it runs in
% local VM (the [ currentdict systemdict ] array it builds is local).
false setglobal

% The graphics machinery is implemented in PostScript and runs in the
% middle of user programs, whose dictionaries are then on the dict
% stack: an unbound operator name in these procedures can be captured
% by an unrelated definition in a user dictionary (a variable named
% /type or /copy, for example). Bind every procedure - including the
% methods of device class dictionaries and the procedures the boot
% files left in systemdict - so operator references are resolved now.
% Names that resolve to procedures are left dynamic, so wrappers still
% dispatch through the dict stack.
[ currentdict systemdict ] {
    {
        exch pop
        dup type /dicttype eq {
            { exch pop
              dup type /arraytype eq 1 index xcheck and { bind } if pop
            } forall
        }{
            dup type /arraytype eq 1 index xcheck and { bind } if pop
        } ifelse
    } forall
} forall

end %userdict

/QUIET where { pop }{ (eof graphics.ps\n)print } ifelse

/TESTGRAPHICS where {pop}{ currentfile flushfile} ifelse
(TESTGRAPHICS graphics)=


currentfile flushfile
initgraphics
