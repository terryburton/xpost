//.internaldict /QUIET known { }{ (loading graphics.ps...\n)print } ifelse

% fallback definitions so this file can run standalone; in the normal flow
% DATA_DIR lives in privatedict, so test for it there
.privatedict /DATA_DIR known {}{
    .privatedict /DATA_DIR {} put
    /strcat{1 1 index length 1 sub getinterval}def
    /breakhere{}def
}ifelse

true setglobal
% The language is defined into systemdict, its final home, rather than
% staged in userdict and swept there afterwards. systemdict is open here
% -- the caller unlocked it -- and the finalizer relocks it.
systemdict begin

    %/CONSTRAINFLATNESS null def

    % graphicsdict holds the live per-render graphics state -- currgstate and
    % the gstack of local gstate copies -- so it and its accessors stay in
    % local VM. Being local they cannot be anchored in systemdict, which is
    % global and refuses a local value; they take a userdict anchor instead,
    % which is the one the finalizer moves into privatedict.
    % The machinery reaches its state dictionary and its device
    % through operators, promoted here before any machinery file
    % loads: every procedure binding as it loads freezes these
    % references, and a program may take either name for itself.
    % The implementation procedures anchor under reserved names so
    % the collector keeps them.
    currentglobal false setglobal
    userdict begin
        /graphicsdict <<
            /currgstate 12 dict
            /gstackarray 100 array
            /gptr -1
        >> def
        .privatedict /.graphicsdict graphicsdict put   % the C operators' direct road in, off the dict stack
        /.graphicsdictproc [ //graphicsdict ] cvx def
    end
    % the dictionary was an anchor for the bake above and nothing else; the
    % name belongs to the operator, and a userdict entry would shadow it
    userdict /graphicsdict undef
    setglobal
    % the operator is not local, so it is defined here, in systemdict
    /graphicsdict dup userdict /.graphicsdictproc get .wrapop def

    % .DEVICEproc is bound only now, with graphicsdict already an operator,
    % so bind freezes the operator into it rather than leaving a name a
    % program could take for itself
    currentglobal false setglobal
    userdict begin
        /.DEVICEproc { graphicsdict /currgstate get /device get } bind def
    end
    setglobal
    /DEVICE dup userdict /.DEVICEproc get .wrapop def

    %breakhere
    (/device.ps) //.xpostsys /.loadmodule get exec %loads and uses (/image.ps)
    (/gstate.ps) //.xpostsys /.loadmodule get exec
    %(/matrix.ps) //.xpostsys /.loadmodule get exec % moved to xpost_op_matrix.c
    (/color.ps) //.xpostsys /.loadmodule get exec
    (/path.ps) //.xpostsys /.loadmodule get exec
    (/clip.ps) //.xpostsys /.loadmodule get exec
    (/paint.ps) //.xpostsys /.loadmodule get exec
    (/font.ps) //.xpostsys /.loadmodule get exec
    (/cid.ps) //.xpostsys /.loadmodule get exec
    (/pattern.ps) //.xpostsys /.loadmodule get exec
    (/shade.ps) //.xpostsys /.loadmodule get exec


% The binding pass below rebinds userdict and systemdict in place; it runs in
% local VM (the [ currentdict systemdict ] array it builds is local).
false setglobal

% The graphics machinery is implemented in PostScript and runs in the
% middle of user programs, whose dictionaries are then on the dict
% stack: an unbound operator name in these procedures can be captured
% by an unrelated definition in a user dictionary (a variable named
% /type or /copy, for example). Bind every procedure - including the
% methods of device class dictionaries, tables nested inside tables,
% and the procedures the boot files left in systemdict - with the
% shared recursive sweep, so operator references are resolved now.
% Names that resolve to procedures are left dynamic, so wrappers still
% dispatch through the dict stack.
[ currentdict systemdict ] { //.xpostsys /.bindscope get exec } forall

end %systemdict

//.internaldict /QUIET known { }{ (eof graphics.ps\n)print } ifelse
