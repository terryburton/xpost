//.internaldict /QUIET known { }{ (loading pgmimage.ps...)print } ifelse

.privatedict /newPGMIMAGEdevice { % width height  .  IMAGE-device-dict
    .privatedict /.xpost_PGMIMAGE get dup /Create get exec
} put

% .xpost_PGMIMAGE, the 8-bit grayscale raster class: the shared raster
% method suite (.makerasterclass, image.ps) over one grey component per
% pixel, a string row per scanline holding the scaled bytes, and
% emission as a raw (P5) portable graymap. It uses the full range 0-255
% of values and does not calculate the actual maximum value in the data
% before transmitting; MaxVal is always 255.
%
% procedures (.xpost_PGMIMAGE is the Class dictionary, IMAGE an
% instance returned by Create):
%           width height .xpost_PGMIMAGE  Create  ->  IMAGE
%                   val x y IMAGE  PutPix  ->  -
%                       x y IMAGE  GetPix  ->  val
%           val x1 y1 x2 y2 IMAGE  DrawLine  ->  -
%      val x y width height IMAGE  DrawRect  ->  -
%      val x y width height IMAGE  FillRect  ->  -
%               val polygon IMAGE  FillPoly  ->  -
%                           IMAGE  Emit  ->  -
%                           IMAGE  Destroy  ->  -
%                           dict1  .copydict  dict2

/.xpost_PGMIMAGE <<
    /nativecolorspace /DeviceGray
    /.ncomp 1
    /BlendPix //.internaldict /.blendpixgray get

    % a string row per scanline; a fresh string is already zero
    /.rowalloc { width string } bind
    /.rowsinit { } bind

    % scale a grey in [0,1] to the stored byte; a read is the byte
    /.packpix { 255 mul cvi } bind
    /.unpackpix { } bind

    % raw (binary) format: each row string is already the raster bytes
    /.writepage { % img file
        2 dict begin
        {/f /a}{exch def}forall
        f (P5\n) writestring
        f a 0 get length =string cvs writestring
        f ( ) writestring
        f a length =string cvs writestring
        f (\n255\n) writestring
        a { f exch writestring } forall
        f (%stdout)(w)file ne {
            f closefile
        } if
        end
    } bind
>> //.xpostsys /.makerasterclass get exec def

//.internaldict /QUIET known { }{ (eof pgmimage.ps\n)print } ifelse
