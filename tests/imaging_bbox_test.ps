%!
% The page device's imaging bounding box (PLRM 6.2).
%
% A program that supplies /ImagingBBox asserts that it paints no marks
% outside the box, and PLRM 6.2 says of the marks that do fall outside
% that they "may or may not be rendered on the output medium". A device
% keeping its page as rows may therefore keep only the rows the box
% reaches. Everything else the program can observe has to stay as it
% was: the page is still the page /PageSize named, the default clipping
% path is still the whole of it, default user space still maps to the
% same device coordinates, and the request still reads back.
%
% Run once per device by run-imaging-bbox-test.sh. The rows a device
% holds are asked of the ones that hold rows; the rest answer the
% questions that are about the page rather than about the raster.

/fails 0 def
/note { print (\n) print } def
/assert { % bool (what)  .  -
    exch { pop }{ /fails fails 1 add def (FAIL: ) print note } ifelse
} bind def
/eqarray { % a1 a2  .  bool
    2 copy length exch length eq {
        true 0 1 3 index length 1 sub {
            3 index 1 index get 3 index 3 -1 roll get eq and
        } for 3 1 roll pop pop
    }{ pop pop false } ifelse
} bind def

/device? { .privatedict /.graphicsdict get /currgstate get /device get } bind def

% -  rowlengths  [len ...]
% how long each of the device's stored rows is; a row the device does
% not store has none of the page in it and answers zero
/rowlengths { [ device? /ImgData get { length } forall ] } bind def

% The page without the hint, for everything the hint must not change.
<< /PageSize [200 200] /ImagingBBox null >> setpagedevice
/plainclip [ gsave newpath clippath pathbbox grestore ] def
/plainmatrix [ matrix defaultmatrix aload pop ] def
/plainorigin [ 0 0 transform ] def
% A device holds the rows this class allocates when it kept the class's
% own Create; a compiled sub-class replaces it and holds its page in one
% block outside the virtual machine, which cannot be held in part.
/holdsrows device? /.bandrows known def
% A device that screens what it stores holds the whole page whatever the
% box says: what it leaves for a grey varies from row to row, so no one
% row of it can stand for the rows that would not be held.
/screens device? /ScreenPaint known def
/plainrows holdsrows { rowlengths }{ [ ] } ifelse def

holdsrows {
    true plainrows { 200 eq and } forall
    (an unhinted page holds a row of the page's width for every row) assert
    plainrows length 200 eq
    (an unhinted page holds one row per page row) assert
} if

% The same page, with a box covering the middle half of it. The box is
% given in default user space, so its top edge (y = 150) is the device
% row 50 and its bottom edge (y = 50) is the device row 150.
<< /PageSize [200 200] /ImagingBBox [50 50 150 150] >> setpagedevice

% 1. The request reads back (PLRM 6.1.1: currentpagedevice reports the
%    parameter settings, and a device that honours the request reports
%    what it honoured).
currentpagedevice /ImagingBBox known
(currentpagedevice carries the imaging bounding box) assert
currentpagedevice /ImagingBBox get [50 50 150 150] eqarray
(currentpagedevice reports the box that was asked for) assert

% 2. The box is not a clip (PLRM 6.2 says so in as many words), so the
%    default clipping path is still the whole page.
[ gsave newpath clippath pathbbox grestore ] plainclip eqarray
(the default clipping path is still the whole page) assert

% 3. Default user space still lands where it did: the box does not move
%    the page image on the medium.
[ matrix defaultmatrix aload pop ] plainmatrix eqarray
(the default matrix is unchanged) assert
[ 0 0 transform ] plainorigin eqarray
(the page origin maps to the same device point) assert

holdsrows screens and {
    % 4a. A screening device holds the page whole, box or no box.
    rowlengths plainrows eqarray
    (a device that screens what it stores holds the whole page) assert
} if

holdsrows screens not and {
    % 4. The rows the box reaches are held; the rest are not.
    /rl rowlengths def
    rl length 200 eq
    (the raster still counts one entry per page row) assert
    % the box's top edge (y = 150) falls on row 50 and its bottom edge
    % (y = 50) on row 150, so rows 50 through 150 are the page it holds
    true 0 1 49 { rl exch get 0 eq and } for
    (the rows above the box are not held) assert
    true 50 1 150 { rl exch get 200 eq and } for
    (the rows the box reaches are held whole) assert
    true 151 1 199 { rl exch get 0 eq and } for
    (the rows below the box are not held) assert
    % held, and fewer of them: an implementation that held every row
    % would pass every test above that is about the page
    0 rl { 0 eq { 1 add } if } forall  99 eq
    (a box covering the middle of the page leaves 99 rows unheld) assert

    % 5. A mark inside the box reaches the raster it belongs to.
    0 setgray newpath 60 60 moveto 90 60 lineto 90 90 lineto 60 90 lineto
    closepath fill
    device? /ImgData get 125 get 75 get 0 eq
    (a mark inside the box is painted) assert

    % 6. A mark outside the box is dropped rather than refused, and
    %    nothing it touched appears anywhere else: the row the box does
    %    reach is left as the fill above left it.
    mark
    { 0 setgray newpath 0 0 moveto 20 0 lineto 20 20 lineto 0 20 lineto
      closepath fill } stopped not
    (a fill outside the box raises no error) assert
    cleartomark
    device? /ImgData get 190 get length 0 eq
    (a fill outside the box leaves the unheld row unheld) assert
    device? /ImgData get 125 get 10 get 0 ne
    (a fill outside the box does not reach a row inside it) assert

    % An image is not painted the way a fill is: its samples are written
    % into the raster row by row, against the rows themselves, so it
    % reaches an unheld row by a path of its own.
    gsave
    mark
    { 40 0 0 40 0 0 6 array astore concat
      4 4 8 [4 0 0 -4 0 4]
      <00408000C0FF40208060A0E01030507090B0D0F0> image } stopped not
    (an image outside the box raises no error) assert
    cleartomark
    grestore
    device? /ImgData get 190 get length 0 eq
    (an image outside the box leaves the unheld row unheld) assert
    device? /ImgData get 125 get 10 get 0 ne
    (an image outside the box does not reach a row inside it) assert
} if

% 7. A null box gives the whole page back (PLRM 6.2: null denotes the
%    largest box the page size allows).
<< /PageSize [200 200] /ImagingBBox null >> setpagedevice
holdsrows {
    rowlengths plainrows eqarray
    (a null box holds the whole page again) assert
    device? /ImgData get 190 get 10 get 0 ne
    (the page a null box gives back can be painted everywhere) assert
} if

fails 0 eq { (SUCCESS) = }{ (FAILURES: ) print fails 20 string cvs note } ifelse
quit
