%!testlib
% The environment operators, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% getenv answers the value of a variable and raises undefined when there
% is none; putenv sets one. They are this interpreter's own operators
% rather than the language's, so what they answer is pinned here rather
% than cited. Both are refused outright while the file-access sandbox is
% engaged, which is why this test runs with it lifted.
%
% A variable set by putenv has to survive the call: the value handed to
% the environment must be the environment's to keep, not memory the
% operator releases on its way out.


% --- a variable that is not set ---
{ (XPOST_TEST_NO_SUCH_VARIABLE) getenv } /undefined
    (getenv of an unset variable is undefined) raises

% --- setting one, and reading it back ---
(XPOST_TEST_VAR) (hello) putenv
{ (XPOST_TEST_VAR) getenv } (a variable set by putenv is found by getenv) works
(XPOST_TEST_VAR) getenv (hello) eq
    (getenv answers the value putenv set) assert
(XPOST_TEST_VAR) getenv length 5 eq
    (the value is as long as the string that set it) assert

% --- the value survives the memory being churned ---
% If the environment kept the operator's own allocation rather than a
% copy of it, whatever took that memory next would show up here.
0 1 2000 { pop 200 string pop } for
(XPOST_TEST_VAR) getenv (hello) eq
    (the value is still there once the memory has turned over) assert

% --- setting it again replaces the value ---
(XPOST_TEST_VAR) (goodbye) putenv
(XPOST_TEST_VAR) getenv (goodbye) eq
    (putenv replaces the value of a variable already set) assert

% --- an empty value is a value ---
(XPOST_TEST_EMPTY) () putenv
{ (XPOST_TEST_EMPTY) getenv } (a variable set to an empty value is still set) works
(XPOST_TEST_EMPTY) getenv length 0 eq
    (the empty value reads back empty) assert

% --- a long value is as long as it was set ---
% A value comes back from the environment as a C string, and the string
% object it becomes records its length in a field narrower than a C
% string's on the smaller of the two object widths. So the length is
% checked against the value that was set rather than assumed: a value
% wrapped into that field would read back short here.
/env.big 20000 string def
0 1 env.big length 1 sub { env.big exch 120 put } for
(XPOST_TEST_LONG) env.big putenv
(XPOST_TEST_LONG) getenv length 20000 eq
    (a long value reads back at the length it was set) assert
(XPOST_TEST_LONG) getenv env.big eq
    (and reads back as the value it was set to) assert

% --- the operands are strings ---
{ 42 getenv } /typecheck (getenv refuses a number) raises
{ (XPOST_TEST_VAR) 42 putenv } /typecheck (putenv refuses a number value) raises
{ 42 (v) putenv } /typecheck (putenv refuses a number name) raises

verdict
