%!testlib
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% exit must terminate every PLRM looping context -- cshow, filenameforall,
% for (integer and real), forall over array/dict/string, kshow, loop,
% pathforall, repeat and resourceforall, the whole list of PLRM 8.2 -- and
% must unwind only the innermost loop. Run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh: prints SUCCESS iff every
% assertion holds.
%
% filenameforall is the load-bearing case: its loop frame historically lacked
% the sentinel that exit searches the exec stack for, so an exit inside its
% procedure fell through the frame into any enclosing loop (or underflowed
% the exec stack), and the glob results leaked.


% --- exit terminates each simple looping context ---
/n 0 def
0 1 9 { pop /n n 1 add def n 3 eq { exit } if } for
n 3 eq (exit terminates integer for) assert

/n 0 def
0.0 0.5 9.0 { pop /n n 1 add def n 4 eq { exit } if } for
n 4 eq (exit terminates real for) assert

/n 0 def
10 { /n n 1 add def n 2 eq { exit } if } repeat
n 2 eq (exit terminates repeat) assert

/n 0 def
{ /n n 1 add def n 2 eq { exit } if } loop
n 2 eq (exit terminates loop) assert

/n 0 def
[ 1 2 3 4 ] { pop /n n 1 add def n 2 eq { exit } if } forall
n 2 eq (exit terminates array forall) assert

/n 0 def
<< /a 1 /b 2 /c 3 >> { pop pop /n n 1 add def exit } forall
n 1 eq (exit terminates dict forall) assert

/n 0 def
(abcd) { pop /n n 1 add def n 2 eq { exit } if } forall
n 2 eq (exit terminates string forall) assert

% --- pathforall ---
% Its enumerator keeps state of its own in a dictionary, so an exit that ends
% it must leave the dictionary stack at the depth it found it (PLRM 8.2: exit
% does not affect the dictionary stack).
/mkpath { newpath 10 10 moveto 20 20 lineto 25 30 30 35 40 40 curveto closepath } def
/counters { { pop pop /n n 1 add def } { pop pop /n n 1 add def }
            { 6 { pop } repeat /n n 1 add def } { /n n 1 add def } } def

/n 0 def
mkpath counters pathforall
n 4 eq (pathforall visits every path element) assert

/n 0 def /depth countdictstack def
mkpath { pop pop /n n 1 add def exit } { pop pop exit }
       { 6 { pop } repeat exit } { exit } pathforall
n 1 eq (exit terminates pathforall) assert
countdictstack depth eq (exit from pathforall leaves the dictionary stack alone) assert

% --- kshow and cshow ---
% Each compiles its walk into one flattened program and runs that, so the
% frame exit unwinds to is not the frame of any loop the walk itself takes:
% it has to be put around the program deliberately.
/Courier findfont 12 scalefont setfont

/n 0 def
newpath 50 50 moveto
{ pop pop /n n 1 add def } (ABCD) kshow
n 3 eq (kshow calls its procedure between every pair of characters) assert

/n 0 def /depth countdictstack def
newpath 50 50 moveto
{ pop pop /n n 1 add def exit } (ABCD) kshow
n 1 eq (exit terminates kshow) assert
countdictstack depth eq (exit from kshow leaves the dictionary stack alone) assert

/outer 0 def
3 { /outer outer 1 add def
    newpath 50 50 moveto { pop pop exit } (ABCD) kshow } repeat
outer 3 eq (exit from kshow spares the enclosing loop) assert

/n 0 def
newpath 50 50 moveto
{ pop pop pop /n n 1 add def } (ABCD) cshow
n 4 eq (cshow calls its procedure once per character) assert

/n 0 def /depth countdictstack def
newpath 50 50 moveto
{ pop pop pop /n n 1 add def exit } (ABCD) cshow
n 1 eq (exit terminates cshow) assert
countdictstack depth eq (exit from cshow leaves the dictionary stack alone) assert

/outer 0 def
3 { /outer outer 1 add def
    newpath 50 50 moveto { pop pop pop exit } (ABCD) cshow } repeat
outer 3 eq (exit from cshow spares the enclosing loop) assert

% --- resourceforall ---
% It enumerates with forall, whose frame exit already finds, and it ends its
% own dictionary after the walk rather than around each call, so the depth
% comes back by itself. Category is a category of every implementation, so
% the walk is guaranteed something to call the procedure with.
/n 0 def
(*) { pop /n n 1 add store } 100 string /Category resourceforall
n 0 gt (resourceforall visits the instances of a populated category) assert

/n 0 def /depth countdictstack def
(*) { pop /n n 1 add store exit } 100 string /Category resourceforall
n 1 eq (exit terminates resourceforall) assert
countdictstack depth eq (exit from resourceforall leaves the dictionary stack alone) assert

/outer 0 def
3 { /outer outer 1 add store
    (*) { pop exit } 100 string /Category resourceforall } repeat
outer 3 eq (exit from resourceforall spares the enclosing loop) assert

% --- exit unwinds only the innermost loop ---
/inner 0 def /outer 0 def
3 { /outer outer 1 add def [ 1 2 3 ] { pop /inner inner 1 add def exit } forall } repeat
outer 3 eq inner 3 eq and (exit stops only the innermost loop) assert

/outer 0 def
3 { /outer outer 1 add def
    mkpath { pop pop exit } { pop pop exit } { 6 { pop } repeat exit } { exit } pathforall
  } repeat
outer 3 eq (exit from pathforall spares the enclosing loop) assert

% --- filenameforall ---
% create two files the template is guaranteed to match
(t_loopexit_a.tmp) (w) file closefile
(t_loopexit_b.tmp) (w) file closefile

% normal completion visits every match
/n 0 def
(t_loopexit_*.tmp) { pop /n n 1 add def } 128 string filenameforall
n 2 eq (filenameforall visits every match) assert

% exit terminates filenameforall after the first match
/n 0 def
(t_loopexit_*.tmp) { pop /n n 1 add def exit } 128 string filenameforall
n 1 eq (exit terminates filenameforall) assert

% and unwinds only the filenameforall frame, not the enclosing loop
/outer 0 def
3 { /outer outer 1 add def (t_loopexit_*.tmp) { pop exit } 128 string filenameforall } repeat
outer 3 eq (exit from filenameforall spares the enclosing loop) assert

% the operand stack is left balanced by all of the above
count 0 eq (operand stack is balanced after the loop-exit tests) assert

(t_loopexit_a.tmp) deletefile
(t_loopexit_b.tmp) deletefile

% --- a stopped context bounds the search (PLRM 8.2: exit does not
%     escape a stopped context; with no loop inside it, invalidexit) ---
/n 0 def
3 { /n n 1 add def { exit } stopped pop } repeat
n 3 eq (an exit inside stopped leaves the enclosing loop running) assert

/caught false def
{ exit } stopped { /caught true def } if
caught (an exit with no loop inside stopped is caught there) assert

% a loop inside the stopped context is still exited normally
/m 0 def
{ 5 { /m m 1 add def exit } repeat } stopped not
    (a loop inside a stopped context still exits normally) assert
m 1 eq (and runs exactly once) assert

% --- exit with no enclosing loop is invalidexit (PLRM 8.2) ---
% It must be an error, and an ordinary one: the enclosing stopped context
% catches it, the interpreter carries on, and $error names it.

{ exit } /invalidexit (exit outside any loop is invalidexit) raises
{ { exit } exec } /invalidexit (exit outside a loop inside a procedure is invalidexit) raises

% the interpreter is still usable afterwards
1 2 add 3 eq (execution continues after an invalidexit) assert

% and exit still works where a loop does enclose it
/n 0 def
5 { /n n 1 add def exit } repeat
n 1 eq (exit still leaves an enclosing loop) assert

verdict
