%!testlib
% The clock operators (PLRM 8.2), run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% realtime counts real time independently of the interpreter; usertime
% counts time the interpreter has spent executing. Both are in
% milliseconds from an arbitrary origin, so what can be asserted is
% their type, that they do not run backwards, and that they do move.
% Each loop below runs until its clock ticks rather than for a fixed
% number of turns, so a fast machine cannot make it fail.


/spins 4000000 def   % a bound, not an expectation

realtime type /integertype eq (realtime answers an integer) assert
usertime type /integertype eq (usertime answers an integer) assert

% --- neither runs backwards ---
/r0 realtime def
/u0 usertime def
realtime r0 ge (realtime does not run backwards) assert
usertime u0 ge (usertime does not run backwards) assert

% --- realtime moves as real time passes ---
/r1 realtime def
/n 0 def
{
    realtime r1 sub 0 gt { exit } if
    /n n 1 add store
    n spins ge { exit } if
} loop
realtime r1 sub 0 gt (realtime advances while the program runs) assert

% --- usertime moves as the interpreter executes ---
/u1 usertime def
/n 0 def
{
    usertime u1 sub 0 gt { exit } if
    /n n 1 add store
    n spins ge { exit } if
} loop
usertime u1 sub 0 gt (usertime advances while the interpreter executes) assert

% --- the interpreter has been executing for all the real time it has
%     used, so the time it reports using is no more than the real time
%     that has passed since the run began.
%
%     The allowance is what the two clocks' resolutions come to. Both
%     are read as whole milliseconds from origins of their own, so each
%     delta is a difference of two truncations; and the clock counting
%     execution is not everywhere kept to the millisecond -- a system
%     that charges execution by the scheduling tick credits the whole
%     tick it was running at the end of, so a short interval can be
%     credited a tick it did not entirely spend. A tick is some tens of
%     milliseconds where it is longest. ---
/slack 40 def
usertime u0 sub realtime r0 sub slack add le
    (the time used is within the real time that passed) assert

verdict
