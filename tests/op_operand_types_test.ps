% Operators handed operands of a type they cannot want, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% An operator that accepts what it cannot use does not fail cleanly: it
% answers a question that has no answer, or stores something that can
% never be read back, or consumes its operand and pushes nothing so that
% whatever runs next fails instead, with nothing to connect the failure
% to its cause. Each of these was found by handing every operator in the
% language an operand of the wrong type and reading what came back.
%
% Every case here was adjudicated against Adobe Distiller, which answers
% typecheck to all of them.

/failcount 0 def
/assert { exch { pop } { (FAIL: ) print print (\n) print
    /failcount failcount 1 add store } ifelse } def

/bad 0 def
/note { (FAIL: ) print print ( ) print print (\n) print
    /bad bad 1 add store } def

/refuses { % {proc} /errname (what)
    /t.w exch def /t.e exch def /t.p exch def
    clear /t.p load stopped {
        $error /errorname get dup t.e ne {
            (FAIL: ) print t.w print ( raised ) print ==
            /bad bad 1 add store
        }{ pop } ifelse
    }{ t.w (was not refused) note } ifelse
    clear
} def
/works { % {proc} (what)
    /t.w exch def /t.p exch def
    clear /t.p load stopped { t.w (was refused) note } if
    clear
} def

% ------------------------------------------------------- access questions
% rcheck and wcheck ask after an access, and only the composite types
% carry one. Asking anything else is not a false, it is a typecheck.

{ [1 2] rcheck pop } (rcheck an array) works
{ 3 dict rcheck pop } (rcheck a dictionary) works
{ (str) rcheck pop } (rcheck a string) works
{ (str) wcheck pop } (wcheck a string) works

(str) readonly rcheck (a readonly string is readable) assert
(str) readonly wcheck not (a readonly string is not writeable) assert
(str) noaccess rcheck not (a noaccess string is not readable) assert

{ null rcheck } /typecheck (rcheck a null) refuses
{ 42 rcheck } /typecheck (rcheck an integer) refuses
{ /nm rcheck } /typecheck (rcheck a name) refuses
{ true rcheck } /typecheck (rcheck a boolean) refuses
{ null wcheck } /typecheck (wcheck a null) refuses
{ 42 wcheck } /typecheck (wcheck an integer) refuses
{ true wcheck } /typecheck (wcheck a boolean) refuses

% ----------------------------------------------------------- the null key
% A key may be any object except null. Stored quietly, a null key
% discarded the value: nothing could ever ask for it again, since null
% is what an empty slot holds.

{ null 42 def } /typecheck (def with a null key) refuses
{ 3 dict null 42 put } /typecheck (put with a null key) refuses
{ 3 dict begin null 42 def end } /typecheck (def in a dictionary) refuses

% and every other key type still works
{ /nm 42 def } (def with a name key) works
{ (str) 42 def } (def with a string key) works
{ 3 dict 42 43 put } (put with an integer key) works
3 dict dup /k 42 put /k get 42 eq (a name key reads back) assert
3 dict dup 7 42 put 7 get 42 eq (an integer key reads back) assert

% -------------------------------------------------- the graphics setters
% Each takes one kind of operand, and took anything.

{ true setstrokeadjust } (setstrokeadjust a boolean) works
{ false setoverprint } (setoverprint a boolean) works
{ { } settransfer } (settransfer a procedure) works

{ null setstrokeadjust } /typecheck (setstrokeadjust a null) refuses
{ 1 setstrokeadjust } /typecheck (setstrokeadjust an integer) refuses
{ (yes) setstrokeadjust } /typecheck (setstrokeadjust a string) refuses
{ null setoverprint } /typecheck (setoverprint a null) refuses
{ 0 setoverprint } /typecheck (setoverprint an integer) refuses
{ null settransfer } /typecheck (settransfer a null) refuses
{ 42 settransfer } /typecheck (settransfer a number) refuses
% a literal array is not a procedure: settransfer is given something to
% execute, and an array that is not executable cannot be
{ [1 2] settransfer } /typecheck (settransfer a literal array) refuses

% ------------------------------------------- the rest of the state setters
% Each of these stored or discarded whatever it was handed. The two that
% take a procedure are checked for executability as well as shape, since
% a literal array is an array that cannot be run.

{ { } setblackgeneration } (setblackgeneration a procedure) works
{ { } setundercolorremoval } (setundercolorremoval a procedure) works
{ 3 dict setcolorrendering } (setcolorrendering a dictionary) works
{ 0.5 setsmoothness } (setsmoothness a real) works
{ 1 setsmoothness } (setsmoothness an integer) works
{ 100 setcachelimit } (setcachelimit an integer) works
{ 1000 setvmthreshold } (setvmthreshold an integer) works

{ null setblackgeneration } /typecheck (setblackgeneration a null) refuses
{ 42 setblackgeneration } /typecheck (setblackgeneration a number) refuses
{ [1 2] setblackgeneration } /typecheck (setblackgeneration a literal array) refuses
{ null setundercolorremoval } /typecheck (setundercolorremoval a null) refuses
{ 42 setundercolorremoval } /typecheck (setundercolorremoval a number) refuses
{ null setcolorrendering } /typecheck (setcolorrendering a null) refuses
{ 42 setcolorrendering } /typecheck (setcolorrendering a number) refuses
{ (x) setsmoothness } /typecheck (setsmoothness a string) refuses
{ null setsmoothness } /typecheck (setsmoothness a null) refuses
% the operand is an integer, so a real is refused rather than converted
{ 1.5 setcachelimit } /typecheck (setcachelimit a real) refuses
{ (100) setcachelimit } /typecheck (setcachelimit a string) refuses
{ null setvmthreshold } /typecheck (setvmthreshold a null) refuses
{ 1.5 setvmthreshold } /typecheck (setvmthreshold a real) refuses

% ------------------------------------------------ the operand before the work
% setgstate fetched the current graphics state before looking at what it
% was given, so an empty stack was reported as a type error about an
% object the program never supplied.

{ setgstate } /stackunderflow (setgstate with an empty stack) refuses
{ 42 setgstate } /typecheck (setgstate an integer) refuses
{ null setgstate } /typecheck (setgstate a null) refuses
{ gstate setgstate } (setgstate a gstate) works

% ------------------------------------------------------------- findfont
% findfont yields a font or says why not. It used to print a note and
% return an empty stack, so the caller failed at whatever it did next.

{ /Helvetica findfont pop } (findfont a name) works
{ (Helvetica) findfont pop } (findfont a string) works
{ /NoSuchFontWhatsoever findfont pop } (findfont an unknown name) works
/Helvetica findfont type /dicttype eq (findfont yields a dictionary) assert
/NoSuchFontWhatsoever findfont type /dicttype eq
    (an unknown name still yields a dictionary) assert

% a key may be any object except null, so only null is refused outright
{ null findfont } /typecheck (findfont a null key) refuses

% ------------------------------------------------------------ conversions
% cvn converts a string. A name is not a string.

{ (str) cvn pop } (cvn a string) works
{ /nm cvn } /typecheck (cvn a name) refuses
{ 42 cvn } /typecheck (cvn a number) refuses
(abc) cvn /abc eq (cvn yields the name of its string) assert

% ------------------------------------------------------------- dictionaries
% where asks which dictionary defines a key, and a key is never null.

{ /pop where pop pop } (where a name) works
{ (pop) where pop pop } (where a string) works
{ null where } /typecheck (where a null) refuses

% ------------------------------------------------------- matrices and state

{ matrix setmatrix } (setmatrix six numbers) works
{ [1 2] setmatrix } /rangecheck (setmatrix a short array) refuses
{ [1 2 3 4 5 6 7] setmatrix } /rangecheck (setmatrix a long array) refuses

{ /Helvetica findfont 12 scalefont setfont } (setfont a font) works
{ 3 dict setfont } /invalidfont (setfont a plain dictionary) refuses
{ 42 setfont } /typecheck (setfont a number) refuses

{ 60 45 { pop pop 0 } setscreen } (setscreen a frequency, angle and spot) works
{ 60 45 60 setscreen } /typecheck (setscreen a number for the spot) refuses
{ (x) 45 { pop pop 0 } setscreen } /typecheck (setscreen a string frequency) refuses
{ 60 (x) { pop pop 0 } setscreen } /typecheck (setscreen a string angle) refuses

{ << /PatternType 1 /PaintType 1 /TilingType 1 /BBox [0 0 8 8]
     /XStep 8 /YStep 8 /PaintProc { pop } >> matrix makepattern setpattern
  0 setgray } (setpattern a pattern) works
{ 3 dict setpattern } /typecheck (setpattern a plain dictionary) refuses
{ 42 setpattern } /typecheck (setpattern a number) refuses

% ------------------------------------------------------------- user paths
% A user path is numbers and user-path operators, each operator preceded
% by exactly the arguments it takes.

{ { 0 0 100 100 setbbox 10 10 moveto 50 50 lineto } uappend } (a user path) works
{ { 0 0 100 100 setbbox 10 10 moveto } ufill } (ufill a user path) works
{ { 1 } uappend } /typecheck (numbers with no operator) refuses
{ { 10 10 show } uappend } /typecheck (an operator that is not a path operator) refuses
{ { 10 moveto } uappend } /typecheck (an operator short of an argument) refuses
{ { 10 10 10 moveto } uappend } /typecheck (an operator with an argument too many) refuses
{ 42 uappend } /typecheck (a number) refuses
{ { 1 } ufill } /typecheck (ufill something that is not a user path) refuses

% the in-tests take a point or a user path, and nothing else
{ 10 10 moveto 20 20 lineto 15 15 infill pop } (infill a point) works
{ { 1 } { 1 } infill } /typecheck (infill something that is not a point) refuses
{ { 1 } { 1 } ineofill } /typecheck (ineofill something that is not a point) refuses

bad 0 eq (every operator refuses what it cannot use) assert

failcount 0 eq { (SUCCESS) = } { (FAILURES: ) print failcount = } ifelse
