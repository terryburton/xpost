% What the text operators mark when the font is an outline font.
% a face answers for this suite's text: a build without a face library
% cannot ask its questions, and says so rather than failing them
systemdict /NOFACES known { (SKIPPED: this suite shows text through a face, and this build carries no face library) = flush quit } if
% Run through `xpost -d null` by run-ps-test.sh: prints SUCCESS iff every
% assertion holds.
%
% PaintType 2 marks an outline font (PLRM 5.4): its glyphs are the
% character outlines stroked with StrokeWidth, a character space
% distance carried to user space through FontMatrix, rather than the
% filled coverage a face renders. The glyph raster route plots that
% filled coverage straight through the device's pixel methods, so an
% outline font has to leave that route and go by its outlines and the
% ordinary stroke, where the line machinery is.
%
% The rule this suite holds every operator to is therefore the same
% glyphs sent round by charpath and stroked with the same width: each
% operator is asked twice, once by itself and once by an outline built
% with the same pen movements, and the two renders must agree pixel for
% pixel. A stroke of the outline is not a fill of it, so each render is
% held apart from the filled form as well -- an operator painting solid
% coverage would otherwise pass by marking something.
%
% The outlines are asked for with charpath's false throughout, which is
% the glyph path itself and the form a stroke of it takes. Its true is
% the stroke's own outline, which is a different path under an outline
% font and is held to its own rule at the end.
%
% The pen is asked as well. PaintType settles how a glyph is painted and
% not how wide it is, so each operator's pen under the outline font is
% compared with its pen under the same face at PaintType 0.

/faildict 2 dict def
faildict /n 0 put
/p.name () def
/check { % bool (what)  .  -
    exch { pop }{
        (FAIL: ) print p.name print ( ) print print (\n) print
        faildict /n 2 copy get 1 add put
    } ifelse
} bind def

/DEV 200 70 .privatedict /newPGMIMAGEdevice get exec def
DEV begin
    /defaultmatrix [ 1 0 0 -1 0 70 ] def
    /FillPoly 1183615869 internaldict /.fillpoly get def
    /FillRect 1183615869 internaldict /.fillrectgray get def
end
.privatedict /.gstatetemplate get exec /device DEV put
graphicsdict /currgstate get /device DEV put

/snap { [ DEV /ImgData get { dup length string copy } forall ] } bind def
/dark { 128 lt } bind def
/inkof { 0 exch { { dark { 1 add } if } forall } forall } bind def
/differs { % a b  .  n
    3 dict begin
    /b exch def /a exch def /n 0 def
    0 1 a length 1 sub { /y exch def
        0 1 a y get length 1 sub { /x exch def
            a y get x get dark  b y get x get dark  ne { /n n 1 add def } if
        } for
    } for
    n
    end
} bind def

% the same face twice, painted as outlines and as solid glyphs.
% StrokeWidth is a character space distance, and character space is a
% thousand units to the em where the face behind the name makes a Type 1
% dictionary and one unit to the em where it makes a Type 42. The width
% is therefore said as the text space distance it is to come to and
% carried into character space through the face's own matrix, so that
% the same line is drawn whichever convention the face brings.
/SW 30 0.001 /Times-Roman findfont /FontMatrix get 0 get div mul def
/Times-Roman findfont dup length dict copy begin
    /PaintType 2 def
    /StrokeWidth SW def
    currentdict
end
/OutlineTimes exch definefont pop

/setfnt { /OutlineTimes findfont 26 scalefont setfont } bind def
/setsolid { /Times-Roman findfont 26 scalefont setfont } bind def
/snapof { % proc  .  snap
    initgraphics erasepage setfnt 0 setgray exec snap
} bind def
/penof { % proc  .  x y
    initgraphics erasepage exec currentpoint
} bind def
/near { % a b  .  bool
    sub abs 0.001 lt
} bind def

% StrokeWidth reaches user space through the font matrix, which is
% where the stroked outline is built
/setlw {
    currentfont /StrokeWidth get 0
    currentfont /FontMatrix get dtransform
    dup mul exch dup mul add sqrt setlinewidth
} bind def

% one character's outline, stroked where it stands, and the pen advanced
% past it: the walkers below paint a glyph per call
/one { % (c)  .  -
    dup gsave currentpoint newpath moveto setlw false charpath stroke grestore
    stringwidth rmoveto
} bind def

% Each case is the operator, an outline built with the same pen
% movements and stroked the same number of times, and the same outline
% filled -- what the operator would mark if it painted the face's solid
% coverage instead.
/CASES [
  [ (show      )
    { 6 24 moveto (Hxy) show }
    { 6 24 moveto gsave currentpoint newpath moveto setlw
      (Hxy) false charpath stroke grestore }
    { 6 24 moveto gsave currentpoint newpath moveto
      (Hxy) false charpath fill grestore } ]
  [ (ashow     )
    { 6 24 moveto 3 0 (Hxy) ashow }
    { 6 24 moveto gsave currentpoint newpath moveto setlw
      (H) false charpath 3 0 rmoveto
      (x) false charpath 3 0 rmoveto
      (y) false charpath 3 0 rmoveto stroke grestore }
    { 6 24 moveto gsave currentpoint newpath moveto
      (H) false charpath 3 0 rmoveto
      (x) false charpath 3 0 rmoveto
      (y) false charpath 3 0 rmoveto fill grestore } ]
  [ (widthshow )
    { 6 24 moveto 5 0 (x) 0 get (Hxy) widthshow }
    { 6 24 moveto gsave currentpoint newpath moveto setlw
      (H) false charpath
      (x) false charpath 5 0 rmoveto
      (y) false charpath stroke grestore }
    { 6 24 moveto gsave currentpoint newpath moveto
      (H) false charpath
      (x) false charpath 5 0 rmoveto
      (y) false charpath fill grestore } ]
  [ (awidthshow)
    { 6 24 moveto 5 0 (x) 0 get 3 0 (Hxy) awidthshow }
    { 6 24 moveto gsave currentpoint newpath moveto setlw
      (H) false charpath 3 0 rmoveto
      (x) false charpath 3 0 rmoveto 5 0 rmoveto
      (y) false charpath 3 0 rmoveto stroke grestore }
    { 6 24 moveto gsave currentpoint newpath moveto
      (H) false charpath 3 0 rmoveto
      (x) false charpath 3 0 rmoveto 5 0 rmoveto
      (y) false charpath 3 0 rmoveto fill grestore } ]
  % glyphshow selects by name rather than by code, and takes the
  % outline by name too; it paints one glyph a call
  [ (glyphshow )
    { 6 24 moveto /H glyphshow /x glyphshow /y glyphshow }
    { 6 24 moveto (H) one (x) one (y) one }
    { 6 24 moveto gsave currentpoint newpath moveto
      (Hxy) false charpath fill grestore } ]
  % and the walkers that reach the raster through show, a glyph a call
  [ (xshow     )
    { 6 24 moveto (Hxy) [ 20 14 12 ] xshow }
    { 6 24 moveto (H) one 26 24 moveto (x) one 40 24 moveto (y) one }
    { 6 24 moveto gsave currentpoint newpath moveto (H) false charpath
      26 24 moveto (x) false charpath 40 24 moveto (y) false charpath
      fill grestore } ]
  [ (kshow     )
    { 6 24 moveto { pop pop 3 0 rmoveto } (Hxy) kshow }
    { 6 24 moveto (H) one 3 0 rmoveto (x) one 3 0 rmoveto (y) one }
    { 6 24 moveto gsave currentpoint newpath moveto
      (H) false charpath 3 0 rmoveto
      (x) false charpath 3 0 rmoveto
      (y) false charpath fill grestore } ]
] def

CASES {
    aload pop
    /c.solid exch def /c.oracle exch def /c.subject exch def /p.name exch def
    /S currentdict /c.subject get snapof def
    /O currentdict /c.oracle get snapof def
    /F currentdict /c.solid get snapof def
    O inkof 0 gt (the stroke of the outline marks the page) check
    S inkof 0 gt (the text marks the page) check
    S O differs 0 eq (the text marks exactly what that stroke marks) check
    S F differs 0 gt (the text is not the solid glyph) check
    { setsolid currentdict /c.subject get exec } penof
    { setfnt currentdict /c.subject get exec } penof
    3 -1 roll near exch 3 -1 roll near and
    (an outline font leaves the pen where a solid one does) check
} forall

% --- the width the outline is stroked with ---------------------------
% StrokeWidth is a character space distance, so a font of twice the size
% strokes twice as wide, and a font without one strokes as thin as the
% device allows rather than refusing.
/p.name (stroke width:) def
/W1 { 6 24 moveto (H) show } snapof def
/setfnt { /OutlineTimes findfont 52 scalefont setfont } bind def
/W2 { 6 48 moveto (H) show } snapof def
W2 inkof W1 inkof gt (a larger size strokes a wider line) check

/Times-Roman findfont dup length dict copy begin
    /PaintType 2 def
    currentdict
end
/BareOutline exch definefont pop
/setfnt { /BareOutline findfont 26 scalefont setfont } bind def
/W3 { 6 24 moveto (H) show } snapof def
W3 inkof 0 gt (a font without StrokeWidth still marks its outline) check

% --- what charpath's boolean asks for --------------------------------
% An outline font's glyphs are the glyph path stroked, so charpath has
% two different paths to hand back and the boolean says which (PLRM
% 8.2): false is the glyph path, the form a stroke of it takes; true is
% the stroke's own outline, the form a fill or a clip takes. For a font
% whose glyphs are filled the two are one path and the boolean decides
% nothing.
%
% The line is made several pixels wide here, so that what the two forms
% are held to is charpath's answer and not the one width at which a
% stroke and a fill of its outline are allowed to part: a stroke of zero
% width is left to the device to draw as thinly as it can (PLRM 7.5.1),
% and the outline it would have filled encloses nothing.
/p.name (charpath bool:) def
/SWW 4 26 div /Times-Roman findfont /FontMatrix get 0 get div def
/Times-Roman findfont dup length dict copy begin
    /PaintType 2 def
    /StrokeWidth SWW def
    currentdict
end
/WideOutline exch definefont pop
/setfnt { /WideOutline findfont 26 scalefont setfont } bind def
/setsolid { /Times-Roman findfont 26 scalefont setfont } bind def

/nelems { % -  .  n
    2 dict begin /n 0 def
    { pop pop /n n 1 add def } { pop pop /n n 1 add def }
    { pop pop pop pop pop pop /n n 1 add def } { /n n 1 add def }
    pathforall n
    end
} bind def

initgraphics setfnt newpath 6 24 moveto (H) false charpath /NF nelems def
initgraphics setfnt newpath 6 24 moveto (H) true charpath /NT nelems def
NF 0 gt (false leaves the glyph path) check
NT NF gt (true leaves a path of its own) check

/T { newpath 6 24 moveto (H) true charpath fill } snapof def
/K { newpath 6 24 moveto setlw (H) false charpath stroke } snapof def
T inkof 0 gt (the fill of the true form marks the page) check
K inkof 0 gt (the stroke of the false form marks the page) check
T K differs 0 eq (the fill of the true form is the stroke of the false) check

initgraphics setsolid newpath 6 24 moveto (H) false charpath /NF nelems def
initgraphics setsolid newpath 6 24 moveto (H) true charpath /NT nelems def
NT NF eq (a filled font answers with the same path either way) check

{ setfnt newpath 6 24 moveto (H) false charpath } penof
{ setfnt newpath 6 24 moveto (H) true charpath } penof
3 -1 roll near exch 3 -1 roll near and
(the boolean does not move the pen) check

count 0 eq (the suite leaves the operand stack empty) check
faildict /n get 0 eq { (SUCCESS) = }{ (FAILURES: ) print faildict /n get = } ifelse
quit
