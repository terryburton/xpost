%!testlib
% readstring (PLRM 8.2), run through `xpost -q --no-sandbox -d null` by
% run-ps-test.sh: prints SUCCESS iff every assertion holds.
%
% readstring fills the string from the file and returns the substring
% filled with true, or the shorter substring with false when end-of-file
% arrived first. No character is special. A zero-length string operand is a
% rangecheck: PLRM 8.2 states it outright, and the operator has no way to
% report "no bytes wanted" otherwise. The access attribute is checked
% first: an unreadable file is invalidaccess whatever the string.

/erris { % { proc } /name (tag)  -> asserts proc raises error /name
    3 dict begin
    /tag exch def /want exch def
    stopped { $error /errorname get want eq }{ false } ifelse
    tag assert clear
    end } def

/nm (rdstr.scratch) def
/f nm (w) file def
f (ab\ncd\000ef) writestring          % a newline and a NUL are ordinary bytes
f closefile

% --- a full read, then a short one at end of file ---
/f nm (r) file def
f 4 string readstring
(a filled string reads true) assert
(ab\ncd) 0 4 getinterval eq (readstring transfers bytes verbatim) assert
f 8 string readstring
not (a partial read at end of file reads false) assert
length 4 eq (a partial read returns only the bytes transferred) assert
f closefile

% --- a NUL byte is data like any other ---
/f nm (r) file def
/s 8 string def
f s readstring pop 5 get 0 eq (a NUL byte is transferred as data) assert
f closefile

% --- a zero-length string is a rangecheck, open or closed ---
/f nm (r) file def
{ f 0 string readstring } /rangecheck
    (readstring into a zero-length string is a rangecheck) erris
f closefile
{ f 0 string readstring } /rangecheck
    (a closed file does not excuse a zero-length string) erris
{ (4142) /ASCIIHexDecode filter 0 string readstring } /rangecheck
    (a filter does not excuse a zero-length string either) erris

% --- but an unreadable file is refused before the string is considered ---
/f nm (w) file def
{ f 0 string readstring } /invalidaccess
    (readstring on a write-only file is invalidaccess) erris
f closefile

nm deletefile

verdict
