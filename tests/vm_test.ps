% Local/global VM integrity checks, run through `xpost -d null` by
% run-ps-test.sh: prints SUCCESS iff every assertion holds.
%
% PLRM's VM rule: a global composite object may not hold a reference to a
% local one, so a local object can never outlive the restore that reclaims it
% while something global still points at it. The rule is enforced uniformly --
% by the put operators AND by literal construction ([ ] and the { } procedure
% builder, which share the array-from-mark path).

/faildict 2 dict def
faildict /n 0 put
/assert { % bool (name) . -
    exch { pop } {
        (FAIL: ) print print (\n) print
        faildict /n 2 copy get 1 add put
    } ifelse
} bind def
/probe { { exec } stopped } bind def    % proc . did-it-raise-an-error?

% --- enforced: a local value may not enter a global container -------------
clear false setglobal /Ld 4 dict def
true setglobal /Gd 4 dict def
{ Gd /k Ld put } probe (a local value is rejected from a global dict) assert

clear true setglobal /Ga 1 array def
false setglobal /La 4 dict def
true setglobal
{ Ga 0 La put } probe (a local value is rejected from a global array) assert

% construction is checked too: building [ local ] under global VM raises
% invalidaccess (the { //local } procedure builder shares this path)
clear false setglobal /Lc 4 dict def
true setglobal
{ [ Lc ] pop } probe (a local value is rejected from a global array literal) assert

% every operator that fills an array element by element enforces the same
% rule, not just put: copy into a global destination, and the packed-array
% and dictstack constructors building in global VM
clear true setglobal /Gcd 1 array def
false setglobal /Lcs [ 4 dict ] def
{ Lcs Gcd copy pop } probe (a local value is rejected from a global array by copy) assert
{ Gcd 0 get type /nulltype eq } probe not (the refused copy left the destination empty) assert

clear false setglobal /Lpk 4 dict def
true setglobal
{ Lpk 1 packedarray pop } probe (a local value is rejected from a global packed array) assert
false setglobal

% userdict is local, so a dictstack snapshot cannot be taken into a global array
clear true setglobal
{ 4 array dictstack pop } probe (a local dict is rejected from a global dictstack array) assert
false setglobal
{ 4 array dictstack pop } probe not (a local dictstack array accepts the dict stack) assert

% --- allowed: a global value may enter a local container; same-VM is fine --
clear false setglobal /Ld2 4 dict def
true setglobal /Gd2 4 dict def
false setglobal
{ Ld2 /k Gd2 put } probe not (a global value is accepted into a local dict) assert

clear false setglobal /La2 1 array def
true setglobal /Gd3 4 dict def
false setglobal
{ La2 0 Gd3 put } probe not (a global value is accepted into a local array) assert

clear true setglobal /Gd4 4 dict def /Gd5 4 dict def
false setglobal
{ Gd4 /k Gd5 put } probe not (global into global is accepted) assert

clear false setglobal /Ld6 4 dict def /Ld7 4 dict def
{ Ld6 /k Ld7 put } probe not (local into local is accepted) assert

% a local array literal may of course hold a local element
clear false setglobal /Lc2 4 dict def
{ [ Lc2 ] pop } probe not (a local array literal accepts a local element) assert

% --- def: the same VM discipline and immediate visibility, through the
%     fused in-procedure path as well as the direct one ---
% a local value is rejected by def when the current dictionary is global
clear false setglobal /Lv3 2 dict def
true setglobal
globaldict begin
{ /gk Lv3 def } probe (a local value is rejected by def into a global dict) assert
end
false setglobal

% a global value defs fine under global VM
clear true setglobal
globaldict begin
{ /gk2 (shared) def gk2 } probe not (a global value defs into a global dict) assert
globaldict /gk2 undef
end
false setglobal
clear

% a def is visible to the very next token of the same procedure (the
% fused fast path must refresh the visible-binding cache), and a redef
% replaces that binding just as immediately
/defseq { /dv1 41 def dv1 1 add /dv2 exch def dv2 } def
defseq 42 eq (a def is visible to the next token in its procedure) assert
/redefseq { /dv3 1 def /dv3 2 def dv3 } def
redefseq 2 eq (a redef replaces the visible binding immediately) assert

clear false setglobal

% --- the allocation mode is subject to save and restore -------------------
% PLRM 8.2 restore: restore resets the VM allocation mode to its state at
% the time of the matching save. The name FontDirectory denotes whichever
% font directory the mode calls for, so it follows the mode back.
% The results are carried past the restores on the operand stack, which
% restore leaves alone: a failure recorded in faildict inside a bracket
% would be rewound by the restore that ends it.
clear false setglobal
/LocalFontDir FontDirectory def

true setglobal
save
    false setglobal
restore
currentglobal
FontDirectory GlobalFontDirectory eq
false setglobal
exch (restore reverts the allocation mode to global) assert
(FontDirectory follows the reverted mode to the global directory) assert

false setglobal
save
    true setglobal
restore
currentglobal not
FontDirectory LocalFontDir eq
false setglobal
exch (restore reverts the allocation mode to local) assert
(FontDirectory follows the reverted mode to the local directory) assert

% a bracket that never touches the mode gives back the mode it was given
true setglobal
save
restore
currentglobal
false setglobal
(a bracket that leaves the mode alone restores it unchanged) assert

% nested brackets each revert to their own save's mode
false setglobal
save
    true setglobal
    save
        false setglobal
    restore
    currentglobal
exch restore
currentglobal not
false setglobal
exch (an inner restore reverts to the inner save's mode) assert
(an outer restore reverts to the outer save's mode) assert

% the mode a save was taken under is what comes back, whatever the bracket
% left it at, so a bracket may be left in either mode
true setglobal
save
    true setglobal
restore
currentglobal
false setglobal
(a bracket that sets the mode it was given still gives it back) assert

% the reverted mode is the mode that allocates: what is made after the
% restore goes into the bank the restore gave back, not the bracket's
true setglobal
save
    false setglobal
restore
4 dict gcheck
false setglobal
(a composite made after a restore lands in the reverted bank) assert

false setglobal
save
    true setglobal
restore
4 dict gcheck not
(a composite made after a restore to local lands in local VM) assert

clear false setglobal

% --- the user interpreter parameters are subject to save and restore ------
% PLRM 8.2 restore: restore resets all user interpreter parameters to their
% state at the time of the matching save; PLRM C.1.1 says the same from the
% other end. As with the allocation mode above, the answers are carried past
% the restores on the operand stack, which restore leaves alone.
/uthr { currentuserparams /VMThreshold get } bind def
/urec { currentuserparams /VMReclaim get } bind def

<< /VMThreshold 4242 >> setuserparams
save
    << /VMThreshold 999999 >> setuserparams
    uthr
exch restore
uthr
4242 eq (restore gives back the user parameter the save was taken with) assert
999999 eq (a user parameter set inside a bracket takes effect there) assert

% VMReclaim names which banks a collection that runs of its own accord
% reclaims, and that setting is what currentuserparams reads: a revert that
% gave the number back without the setting could not answer here
<< /VMReclaim 0 >> setuserparams
save
    << /VMReclaim -2 >> setuserparams
    urec
exch restore
urec
0 eq (restore gives back the automatic collection the save was taken with) assert
-2 eq (a VMReclaim set inside a bracket turns automatic collection off there) assert

% nested brackets each revert to their own save's value
<< /VMThreshold 100 >> setuserparams
save
    << /VMThreshold 200 >> setuserparams
    save
        << /VMThreshold 300 >> setuserparams
    restore
    uthr
exch restore
uthr
100 eq (an outer restore reverts a user parameter to the outer save's value) assert
200 eq (an inner restore reverts a user parameter to the inner save's value) assert

% a bracket that leaves the parameters alone gives them back unchanged, and
% one that sets the value it was already given gives that back too, so the
% revert cannot pass by always answering a default
<< /VMThreshold 555 >> setuserparams
save
restore
uthr 555 eq (a bracket that leaves a user parameter alone restores it unchanged) assert

<< /VMThreshold 777 >> setuserparams
save
    << /VMThreshold 777 >> setuserparams
restore
uthr 777 eq (a bracket that sets the value it was given still gives it back) assert

% outside a bracket the effect is cumulative (PLRM C.1)
<< /VMThreshold 888 >> setuserparams
uthr 888 eq (a user parameter set outside a bracket keeps its value) assert

% PLRM 8.2 setvmthreshold: the parameter it sets is the VMThreshold user
% parameter, so it is read back with the others and reverts with them
1234 setvmthreshold
uthr 1234 eq (setvmthreshold sets the VMThreshold user parameter) assert
save
    5678 setvmthreshold
restore
uthr 1234 eq (restore reverts a threshold set through setvmthreshold) assert
-1 setvmthreshold
uthr 0 eq (setvmthreshold -1 asks for the default threshold) assert
{ -5 setvmthreshold } probe $error /errorname get /rangecheck eq and
    (a negative threshold other than -1 is a rangecheck) assert
clear

% PLRM 8.2 setuserparams: a value the implementation cannot achieve is
% replaced by the nearest it can, without an error indication
<< /VMThreshold 4242 >> setuserparams
{ << /VMThreshold -5 >> setuserparams } probe not
    (setuserparams does not raise for a threshold it cannot achieve) assert
uthr 0 eq (an unachievable threshold is replaced by the nearest achievable) assert

<< /VMReclaim -1 >> setuserparams
{ << /VMReclaim 2 >> setuserparams } probe not
    (setuserparams does not raise for a VMReclaim it cannot hold) assert
urec -1 eq (a VMReclaim naming no collector setting leaves the setting alone) assert
<< /VMReclaim 0 >> setuserparams

% the stack sizes are capacities this interpreter fixes: asking for another
% is accepted and answered with the capacity, which is the one it enforces
<< /VMThreshold 4242 >> setuserparams
currentuserparams /MaxOpStack get
{ << /MaxOpStack 300 >> setuserparams } probe not
    (a stack capacity may be asked for without an error) assert
currentuserparams /MaxOpStack get eq
    (a stack capacity request is answered with the capacity) assert
currentuserparams /MaxDictStack get 0 gt
    (currentuserparams reports a dictionary stack capacity) assert
currentuserparams /MaxExecStack get 0 gt
    (currentuserparams reports an execution stack capacity) assert
uthr 4242 eq (a stack capacity request leaves the other parameters alone) assert

% and the capacity reported is the one enforced: a dictionary stack filled
% to the number reported is accepted, and driving it past that number is
% dictstackoverflow. The ceilings are read at intervals rather than at every
% push, so what the second half asks for is a stack driven well past.
/dsfill {
    currentuserparams /MaxDictStack get countdictstack sub
    { 1 dict begin } repeat
} bind def
/dspast { 4096 { 1 dict begin } repeat } bind def
{ dsfill } probe not
    (the dictionary stack fills to the capacity reported) assert
{ dspast } probe $error /errorname get /dictstackoverflow eq and
    (a dictionary stack driven past the capacity reported overflows) assert
cleardictstack
clear

% a value of the wrong type is a typecheck, and leaves the parameter alone
{ << /VMThreshold (x) >> setuserparams } probe $error /errorname get /typecheck eq and
    (a non-integer user parameter value is a typecheck) assert
clear
uthr 4242 eq (a refused setuserparams leaves the parameter alone) assert
{ << /VMThreshold 1.5 >> setuserparams } probe $error /errorname get /typecheck eq and
    (a real user parameter value is a typecheck) assert
clear

% the dictionary is searched, so it needs read access
{ 1 dict dup /VMThreshold 42 put noaccess setuserparams } probe
$error /errorname get /invalidaccess eq and
    (setuserparams on an unreadable dictionary is invalidaccess) assert
clear
uthr 4242 eq (the refused dictionary changed nothing) assert

% PLRM 8.2 setuserparams: a key naming no parameter of this implementation
% is ignored
{ << /ZorkParam 5 >> setuserparams } probe not
    (a key naming no user parameter is ignored) assert

% currentuserparams hands back a fresh dictionary, not the interpreter's own
currentuserparams currentuserparams ne
    (currentuserparams returns a different dictionary each time) assert
currentuserparams dup /Zork 1 put /Zork known
    (the dictionary currentuserparams returns is writable) assert
currentuserparams /Zork known not
    (a fresh dictionary does not carry an earlier one's entries) assert

<< /VMThreshold 0 >> setuserparams
clear false setglobal

count 0 eq (operand stack is balanced) assert
faildict /n get 0 eq { (SUCCESS\n) print } { faildict /n get =print ( failures\n) print } ifelse
flush
quit
