% The golden render page: one deterministic page exercising the paint
% pipeline broadly -- fills under both winding rules, strokes with caps,
% joins and dashes, rectangular and path-shaped clipping, sampled images
% and masks, axial and radial shading, a tiling pattern, and text from an
% inline Type 3 font (nothing host-dependent: no system fonts, no dates,
% no randomness). run-golden-render.sh renders it through every
% deterministic output device and compares the bytes against
% tests/golden/manifest.sha256; a refactor that claims to preserve
% behavior must reproduce these bytes exactly.

% --- fills: winding rules over self-intersecting geometry ---
gsave
  36 640 translate
  newpath 0 0 moveto 80 0 lineto 8 50 lineto 40 -14 lineto 72 50 lineto closepath
  0.2 setgray fill
  100 0 translate
  newpath 0 0 moveto 80 0 lineto 8 50 lineto 40 -14 lineto 72 50 lineto closepath
  0.2 setgray eofill
grestore

% --- strokes: width, caps, joins, miter limit, dashes ---
gsave
  36 560 translate
  0 setgray
  12 setlinewidth
  0 1 2 { /c exch def
    c setlinecap
    newpath c 40 mul 10 add 0 moveto 0 40 rlineto
    stroke
  } for
  140 0 translate
  0 1 2 { /j exch def
    j setlinejoin
    newpath j 60 mul 0 moveto 20 40 rlineto 20 -40 rlineto
    stroke
  } for
  1 setlinewidth 0 setlinecap
  [ 6 3 1 3 ] 2 setdash
  newpath -100 -20 moveto 320 0 rlineto stroke
  [] 0 setdash
grestore

% --- colour: rgb / cmyk / hsb, and a Separation space ---
gsave
  36 480 translate
  1 0 0 setrgbcolor           0 0 40 40 rectfill
  0 1 0.5 0 0 setcmykcolor   50 0 40 40 rectfill
  0.6 1 1 sethsbcolor        100 0 40 40 rectfill
  [ /Separation (Spot) /DeviceRGB { dup dup 1 exch sub 3 1 roll pop pop 0.9 exch 0.1 } ] setcolorspace
  0.7 setcolor              150 0 40 40 rectfill
grestore

% --- clipping: rectangle intersection and a path-shaped eoclip ---
gsave
  36 380 translate
  newpath 0 0 moveto 90 0 lineto 90 70 lineto 0 70 lineto closepath clip
  newpath 45 35 60 0 360 arc 0.4 setgray fill
grestore
gsave
  160 380 translate
  newpath 45 35 40 0 360 arc 45 35 18 0 360 arc eoclip
  0 0.3 0.6 setrgbcolor 0 0 90 70 rectfill
grestore

% --- images: 8-bit gray, colour, and a stencil mask (inline data) ---
gsave
  36 280 translate
  60 60 scale
  8 8 8 [ 8 0 0 -8 0 8 ]
  { <001133557799bbdd 113355 7799bbddff 33557799 bbddff00 557799bb ddff0011
     7799bbdd ff001133 99bbddff 00113355 bbddff00 11335577 ddff0011 33557799> }
  image
grestore
gsave
  116 280 translate
  60 60 scale
  4 4 8 [ 4 0 0 -4 0 4 ]
  { <ff0000 00ff00 0000ff ffff00 ff00ff 00ffff 804020 204080
     102030 302010 c0c0c0 404040 ff8000 0080ff 80ff00 8000ff> }
  false 3 colorimage
grestore
gsave
  196 280 translate
  60 60 scale
  0.8 0.2 0.1 setrgbcolor
  8 8 true [ 8 0 0 -8 0 8 ]
  { <c3a5997e7e99a5c3> }
  imagemask
grestore

% --- shading: axial and radial ---
gsave
  36 180 translate
  << /ShadingType 2 /ColorSpace /DeviceRGB
     /Coords [ 0 0 120 0 ]
     /Function << /FunctionType 2 /Domain [0 1] /N 1
                  /C0 [1 0.9 0] /C1 [0.1 0 0.8] >>
  >> shfill
  0 0 120 50 rectclip
grestore
gsave
  200 180 translate
  newpath 40 25 40 0 360 arc clip
  << /ShadingType 3 /ColorSpace /DeviceGray
     /Coords [ 40 25 0 40 25 40 ]
     /Function << /FunctionType 2 /Domain [0 1] /N 2 /C0 [1] /C1 [0] >>
  >> shfill
grestore

% --- pattern: a tiled cell ---
gsave
  36 90 translate
  << /PatternType 1 /PaintType 1 /TilingType 1
     /BBox [0 0 12 12] /XStep 12 /YStep 12
     /PaintProc { pop 0.1 0.4 0.2 setrgbcolor 0 0 7 7 rectfill
                  0.9 0.6 0.1 setrgbcolor 6 6 12 12 rectfill }
  >> matrix makepattern setpattern
  0 0 130 60 rectfill
grestore

% --- text: an inline Type 3 font, scaled and rotated ---
/GoldType3 7 dict begin
  /FontType 3 def
  /FontMatrix [ 0.001 0 0 0.001 0 0 ] def
  /FontBBox [ 0 0 750 750 ] def
  /Encoding 256 array def
  0 1 255 { Encoding exch /.notdef put } for
  Encoding 88 /ex put       % X
  Encoding 79 /oh put       % O
  /CharProcs << /.notdef {}
    /ex { 100 setlinewidth 50 50 moveto 650 650 lineto
          50 650 moveto 650 50 lineto stroke }
    /oh { 350 350 300 0 360 arc 100 setlinewidth stroke }
  >> def
  /BuildChar { % font code
      exch begin
      Encoding exch get CharProcs exch get
      750 0 setcharwidth exec
      end } def
  currentdict
end definefont pop

gsave
  200 90 translate
  /GoldType3 findfont 40 scalefont setfont
  0 setgray 0 0 moveto (XOX) show
  30 rotate 0.5 setgray 20 10 moveto (OX) show
grestore

showpage
