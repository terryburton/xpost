# Private-namespace members and their homes, one "DICT /name" per line.
# The dict-homes test asserts every pair still appears in data/*.ps: a
# member may gain company but may not move home or vanish. A feature
# that adds a member appends it here in the same commit, so the file
# is the running register of where interpreter machinery lives.
.gscratch /.pfdict
.gscratch /strokedict
.internaldict /.fillpoly
.internaldict /.fillrectgray
.internaldict /GRAPHICS
.internaldict /QUIET
.internaldict /.=stringproc
.internaldict /.sysdictrelock
.internaldict /USEDRAWLINE
.privatedict /DATA
.privatedict /.error
.privatedict /.graphicsdict
.privatedict /.gstatetemplate
.privatedict /newnulldevice
.privatedict /.xpost
.xpostsys /arcbez
.xpostsys /bitsdict
.xpostsys /.c01
.xpostsys /ColorConversion
.xpostsys /cpath
.xpostsys /crossdashbound
.xpostsys /currentcolordict
.xpostsys /dashdict
.xpostsys /dashpath
.xpostsys /deepcopy
.xpostsys /despike
.xpostsys /.devpathforall
.xpostsys /.dir
.xpostsys /doclip
.xpostsys /dolinejoin
.xpostsys /dopending
.xpostsys /doprompt
.xpostsys /evaluate
.xpostsys /.finalize
.xpostsys /flattendict
.xpostsys /.fontsubstitutions
.xpostsys /gstatecopy
.xpostsys /h
.xpostsys /.handlejoberror
.xpostsys /hodgman
.xpostsys /initial
.xpostsys /.instof
.xpostsys /loadgraphics
.xpostsys /.loadmodule
.xpostsys /magang
.xpostsys /.min
.xpostsys /minlinewidth
.xpostsys /normclipwind
.xpostsys /p2abc
.xpostsys /pause
.xpostsys /pendingdict
.xpostsys /polyarea2
.xpostsys /ptdiff
.xpostsys /qsort
.xpostsys /ravec
.xpostsys /rect
.xpostsys /.resources
.xpostsys /reversedict
.xpostsys /setcolordict
.xpostsys /ShowpageSemanticsDict
.xpostsys /.strcat
.xpostsys /xpost
