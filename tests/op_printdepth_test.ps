% What == does with a structure that contains itself, run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% The printer descends into each array it meets. A structure that
% contains itself has no bottom, so the descent is bounded: past the
% bound an array prints as an array rather than being entered. Finite
% structures are unaffected, and the bound is deep enough that ordinary
% nesting never reaches it.

/failcount 0 def
/assert { exch { pop } { (FAIL: ) print print (\n) print
    /failcount failcount 1 add store } ifelse } def

% a string to print into, so the output can be examined rather than
% merely produced
/out 4096 string def
/captured 0 def

% --------------------------------------------------- a structure containing itself

/a [ 1 2 3 ] def
a 0 a put
{ a == } stopped not (a self-referential array prints and returns) assert

/d 3 dict def
d /self d put
{ d == } stopped not (a self-referential dictionary prints and returns) assert

% two arrays that contain each other
/p [ 1 2 ] def
/q [ 3 4 ] def
p 0 q put
q 0 p put
{ p == } stopped not (two arrays containing each other print) assert

% --------------------------------------------------------- finite structures

{ [ 1 [ 2 [ 3 [ 4 [ 5 ] ] ] ] ] == } stopped not
    (a finitely nested array prints) assert
{ [ 1 2 3 ] == } stopped not (a flat array prints) assert
{ { 1 2 add } == } stopped not (a procedure prints) assert
{ [ (a) /b 1 2.5 true null ] == } stopped not
    (an array of every simple type prints) assert

% nesting well beyond anything ordinary, still finite, still entered
% rather than abbreviated: twelve deep
/deep [ 1 ] def
12 { [ deep ] /deep exch def } repeat
{ deep == } stopped not (an array twelve deep prints) assert

failcount 0 eq { (SUCCESS) = } { (FAILURES: ) print failcount = } ifelse
