% The file operator's access strings (PLRM 3.8.1, Table 3.5), run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh: prints SUCCESS iff every
% assertion holds.
%
% An access string begins with r, w or a, optionally followed by +:
%   r   read only, the file must exist
%   w   write only, created or truncated
%   a   write only, created or appended to
%   r+  read and write, the file must exist
%   w+  read and write, created or truncated
%   a+  read and write, created or appended to
% The file object's access attribute follows from the string, so a use that
% the attribute forbids is an invalidaccess (PLRM 3.8.1). An access string
% that is not one of these is an invalidfileaccess.

/failcount 0 def
/assert { exch { pop } { (FAIL: ) print print (\n) print
    /failcount failcount 1 add store } ifelse } def
/erris { % { proc } /name (tag)  -> asserts proc raises error /name
    3 dict begin
    /tag exch def /want exch def
    stopped { $error /errorname get want eq }{ false } ifelse
    tag assert clear
    end } def
/slurp { % (name) . (contents)
    2 dict begin
    /nm exch def
    /f nm (r) file def
    /s 64 string def
    f s readstring pop
    f closefile
    end } def

/nm (faccess.scratch) def

% --- w creates and truncates ---
/f nm (w) file def f (AB) writestring f closefile
nm slurp (AB) eq (w writes the file) assert
/f nm (w) file def f (Z) writestring f closefile
nm slurp (Z) eq (w truncates an existing file) assert

% --- a appends to an existing file ---
/f nm (a) file def f (YX) writestring f closefile
nm slurp (ZYX) eq (a appends to an existing file) assert
nm deletefile
/f nm (a) file def f (Q) writestring f closefile
nm slurp (Q) eq (a creates a file that does not exist) assert

% --- r+ reads and writes an existing file ---
nm deletefile
/f nm (w) file def f (abcd) writestring f closefile
/f nm (r+) file def
f 2 string readstring pop (ab) eq (r+ reads) assert
f 2 setfileposition
f (ZZ) writestring
f closefile
nm slurp (abZZ) eq (r+ writes in place) assert

% --- w+ truncates, then reads back what it wrote ---
/f nm (w+) file def
f (hello) writestring
f 0 setfileposition
f 5 string readstring pop (hello) eq (w+ reads back its own writes) assert
f closefile
nm slurp (hello) eq (w+ truncated the previous contents) assert

% --- a+ appends and reads ---
/f nm (a+) file def
f (!) writestring
f 0 setfileposition
f 6 string readstring pop (hello!) eq (a+ reads the whole file) assert
f closefile

% --- the access attribute follows the access string ---
/f nm (r) file def
{ f 65 write } /invalidaccess (a file opened r refuses a write) erris
f closefile
/f nm (w) file def
{ f read } /invalidaccess (a file opened w refuses a read) erris
f closefile

% --- executing a file reads it, so the attribute governs that too ---
% PLRM 3.8.2: accessing a file object in a way its access attribute forbids
% is an invalidaccess. Execution reads the file, one token at a time, so a
% file the attribute will not let be read will not be executed either.
/f nm (w) file def
{ f cvx exec } /invalidaccess (a file opened w refuses to be executed) erris
f closefile
/f nm (a) file def
{ f cvx exec } /invalidaccess (a file opened a refuses to be executed) erris
f closefile
% a filter carries the attribute of the direction it codes in
/f nm (w) file /ASCIIHexEncode filter def
{ f cvx exec } /invalidaccess (an encoding filter refuses to be executed) erris
f closefile
% while every readable one runs as before, to the end of the file
nm deletefile
/f nm (w) file def f (/f.ran f.ran 1 add def\n) writestring f closefile
/f.ran 0 def
nm (r) file cvx exec
f.ran 1 eq (a file opened r executes) assert
nm (r+) file cvx exec
f.ran 2 eq (a file opened r+ executes) assert
nm (w+) file dup (/f.ran f.ran 1 add def\n) writestring
    dup 0 setfileposition cvx exec
f.ran 3 eq (a file opened w+ executes) assert

% --- an access string outside the table is invalidfileaccess ---
{ nm (q) file } /invalidfileaccess (an unknown access string is refused) erris
{ nm (rw) file } /invalidfileaccess (an access string must start r, w or a) erris
{ nm () file } /invalidfileaccess (an empty access string is refused) erris

% --- and r on a file that does not exist is undefinedfilename ---
{ (faccess_absent.scratch) (r) file } /undefinedfilename
    (r on a file that does not exist is undefinedfilename) erris

nm deletefile

failcount 0 eq { (SUCCESS) = } { (FAILURES: ) print failcount = } ifelse
