% Two pages of vector output for a destination that cannot be positioned.
% The output file comes from the command line, so the paginated single-file
% writer runs and has to place a cross-reference entry for every object.
0 0 moveto 100 0 rlineto 0 50 rlineto -100 0 rlineto closepath fill
showpage
0.5 setgray
20 20 moveto 60 0 rlineto 0 60 rlineto closepath fill
showpage
