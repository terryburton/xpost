01>
pop dup length 340 eq exch st.lzwsum 42450 eq and
(EarlyChange 0 defers the wider code to the table boundary) assert

failcount 0 eq { (SUCCESS\n) print } { (FAILURES: ) print failcount 20 string cvs print (\n) print } ifelse
flush
quit
