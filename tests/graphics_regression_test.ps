% Type 3 fonts serve glyphshow through their BuildGlyph procedure, as
% plotting tools emit them (a name-keyed CharStrings of drawing
% procedures); a font defining only BuildGlyph also answers show
% through the derived BuildChar, and one defining only BuildChar
% serves glyphshow through the code its Encoding assigns the name.
9 dict begin
    /FontType 3 def
    /FontMatrix [0.01 0 0 0.01 0 0] def
    /FontBBox [0 0 100 100] def
    /Encoding 256 array def
    0 1 255 { Encoding exch /.notdef put } for
    Encoding 65 /box put
    /CharStrings << /box { 0 0 60 60 rectfill } /.notdef {} >> def
    /BuildGlyph {
        exch begin
        80 0 setcharwidth
        CharStrings exch 2 copy known not { pop /.notdef } if get exec
        end
    } def
currentdict end
/T3GlyphTest exch definefont pop
/T3GlyphTest findfont 20 scalefont setfont
erasepage
10 16 moveto /box glyphshow
countink 100 ge (BuildGlyph serves glyphshow) assert
currentpoint pop 26 sub abs 0.5 le (the BuildGlyph width advances the pen) assert
erasepage
10 16 moveto (A) show
countink 100 ge (a BuildGlyph-only font answers show) assert
currentpoint pop 26 sub abs 0.5 le (show advances through the derived BuildChar) assert
9 dict begin
    /FontType 3 def
    /FontMatrix [0.01 0 0 0.01 0 0] def
    /FontBBox [0 0 100 100] def
    /Encoding 256 array def
    0 1 255 { Encoding exch /.notdef put } for
    Encoding 66 /tribar put
    /BuildChar {
        exch begin
        80 0 setcharwidth
        Encoding exch get /tribar eq { 0 0 60 30 rectfill } if
        end
    } def
currentdict end
/T3CharTest exch definefont pop
/T3CharTest findfont 20 scalefont setfont
erasepage
10 16 moveto /tribar glyphshow
countink 50 ge (BuildChar serves glyphshow through the Encoding) assert
currentpoint pop 26 sub abs 0.5 le (the BuildChar width advances the pen) assert
erasepage

% --- procedure-implemented standard operators stand as operators ---
% load answers operatortype for them, so bind substitutes them and the
% classic self-redefinition idiom captures the standard behaviour
% instead of recursing into the new definition
/stroke load type /operatortype eq (stroke loads as an operator) assert
/fill load type /operatortype eq (fill loads as an operator) assert
/show load type /operatortype eq (show loads as an operator) assert
gsave
/bnd.st /stroke load def
/stroke { 2 2 scale stroke } bind def
newpath 10 10 moveto 20 20 lineto stroke
userdict /stroke undef   % drop the shadow; the standard stroke returns
userdict /bnd.st undef
true (a bound self-redefinition of stroke terminates) assert
grestore

% an error that unwinds out of a wrapped operator is the operator's
% error: it names the command, and the stacks return to their depths
% at the call -- what the procedure part-way pushed drops, operands
% still in place stay
/ep.op /ep.testname { (j1) (j2) ep.doesnotexist } .wrapop def
count /ep.d0 exch def
1 2 { ep.op } stopped
(the wrapped-operator error is caught) assert
$error /command get dup type /operatortype eq
exch 32 string cvs (ep.testname) eq and
(an error in a wrapped operator names the operator) assert
count ep.d0 sub 2 eq (the operand depth at the call comes back) assert
pop pop
% nested wrapped calls report the innermost and unwind to the caller
/ep.in /ep.inner { 7 8 ep.alsomissing } .wrapop def
/ep.out /ep.outer { (x) (y) ep.in } .wrapop def
count /ep.d1 exch def
{ ep.out } stopped pop
$error /command get 32 string cvs (ep.inner) eq
(a nested wrapped error names the innermost operator) assert
count ep.d1 eq (a nested wrapped error unwinds the operand junk) assert
% a wrapper that catches its own error keeps its own state
/ep.c /ep.catcher { (kept) { ep.gone } stopped pop } .wrapop def
ep.c (kept) eq (a wrapper catching its own error keeps its stack) assert
% the dict stack comes back when the procedure dies inside a begin
countdictstack /ep.dd exch def
/ep.d /ep.dicty { 5 dict begin ep.nothere } .wrapop def
{ ep.d } stopped pop
countdictstack ep.dd eq (the dict depth at the call comes back) assert

% --- charpath appends glyph outlines: the path carries curves, fills
%     with its counters intact, and clips like any other path ---
basefont null ne {
    /cpd 4 dict def
    cpd /nc 0 put cpd /nm 0 put
    erasepage
    basefont 40 scalefont setfont
    newpath 8 20 moveto (O) false charpath
    { pop pop cpd /nm 2 copy get 1 add put }
    { pop pop }
    { 6 { pop } repeat cpd /nc 2 copy get 1 add put }
    { }
    pathforall
    cpd /nm get 2 ge (charpath makes a contour per boundary) assert
    cpd /nc get 8 ge (charpath carries curve segments) assert
    fill
    countink 20 ge (charpath fills) assert
    % the counter must stay clear: probe the middle of the O
    23 34 inkat not (charpath fill keeps the counter open) assert
    10 34 inkat (charpath fill marks the ring) assert

    erasepage
    gsave
    newpath 8 20 moveto (O) false charpath clip
    newpath 0 0 moveto 64 0 lineto 64 64 lineto 0 64 lineto closepath fill
    grestore
    23 34 inkat not (charpath clip keeps the counter open) assert
    10 34 inknear (charpath clip admits the ring) assert
} if

% --- text metrics: stringwidth reports the scaled glyph advances ---
% a bold digit spans roughly half its em -- far from the rounded-to-a-
% whole-pixel failure mode of one em per glyph -- and the reported
% width scales linearly with the font size, including sub-unit sizes
basefont null ne {
/Helvetica-Bold findfont 13 scalefont setfont
(23) stringwidth pop /w13 exch def
w13 13 div dup 0.8 gt exch 1.6 lt and ((23) width is a plausible em fraction) assert
/Helvetica-Bold findfont 1 scalefont setfont
(23) stringwidth pop 13 mul
w13 (stringwidth scales linearly with the font size) assertnear
/Helvetica-Bold findfont 0.62 scalefont setfont
(23) stringwidth pop 13 mul 0.62 div
w13 (a sub-unit font size scales the advances) assertnear

% the pen moves by exactly the width stringwidth reports
erasepage
/Helvetica-Bold findfont 13 scalefont setfont
(23) stringwidth pop /w13 exch def
newpath 4 20 moveto (23) show
currentpoint pop 4 sub
w13 (show advances the pen by stringwidth) assertnear
} if

% --- font identity: scalefont and makefont build dictionaries ---
% scaling a font returns a new dictionary carrying the size in its
% FontMatrix and leaves the operand font untouched. The base follows
% the Type 1 convention (0.001: 1000 character-space units per em),
% so the scaled copy carries size/1000
basefont null ne {
/Helvetica-Bold findfont dup 13 scalefont
2 copy eq not (scalefont returns a new dictionary) assert
exch /FontMatrix get 0 get
0.001 (scalefont leaves the operand font unscaled) assertnear
/FontMatrix get 0 get
0.013 (scalefont carries the size in the copy's FontMatrix) assertnear

% two sizes of one face coexist: measuring through one dictionary must
% not disturb the other
/Helvetica-Bold findfont 13 scalefont /F13x exch def
/Helvetica-Bold findfont 7 scalefont /F7x exch def
F13x setfont (23) stringwidth pop /wa13 exch def
F7x setfont (23) stringwidth pop /wa7 exch def
F13x setfont (23) stringwidth pop
wa13 (a font is unaffected by uses of its siblings) assertnear
wa13 7 mul
wa7 13 mul (two sizes of one face are in proportion) assertnear

% rendered ink likewise: drawing small, then using the large font,
% then drawing small again yields the same marks
erasepage
F7x setfont newpath 4 20 moveto (23) show
countink /smallink exch def
erasepage
F13x setfont (23) stringwidth pop pop
F7x setfont newpath 4 20 moveto (23) show
countink smallink eq (a font's marks are unaffected by uses of its siblings) assert

% the CTM applies when glyphs are marked, not when the font is scaled:
% a font scaled under a magnified CTM is the same font...
gsave 7 7 scale /Helvetica-Bold findfont 13 scalefont grestore
setfont (23) stringwidth pop
wa13 (scalefont does not bake the CTM of its moment) assertnear

% ...stringwidth reports user space whatever the CTM...
F13x setfont
gsave 7 7 scale (23) stringwidth pop grestore
wa13 (stringwidth is CTM-independent) assertnear

% ...and the CTM in force at show time scales the marks
erasepage
F7x setfont
gsave 2 2 scale newpath 4 12 moveto (23) show grestore
countink smallink gt (the CTM at show time scales the marks) assert

% makefont concatenates its matrix onto the FontMatrix: an anisotropic
% matrix stretches the advances by its x component
/Helvetica-Bold findfont [26 0 0 52 0 0] makefont setfont
(23) stringwidth pop
wa13 2 mul (makefont scales the advances by its x component) assertnear

% a sub-pixel em is served exactly: FreeType cannot size a face below
% a pixel, so the interpreter carries the residual scale itself; the
% advances stay linear all the way down
/Helvetica-Bold findfont 0.25 scalefont setfont
(23) stringwidth pop 13 mul 0.25 div
wa13 (a sub-pixel em scales the advances) assertnear

% and a sub-pixel em under a magnifying CTM marks like the equivalent
% point size: 0.3 em drawn at 40x covers the ink of 12 pt within a
% rasterization tolerance
erasepage
/Helvetica-Bold findfont 12 scalefont setfont
newpath 4 20 moveto (6) show
countink /ink12 exch def
erasepage
/Helvetica-Bold findfont 0.3 scalefont setfont
gsave 40 40 scale newpath 0.1 0.5 moveto (6) show grestore
countink ink12 sub abs
ink12 0.15 mul lt (a sub-pixel em under a magnifying CTM marks at full size) assert

% an annulus clip built the standard way: the closepath's point bridges
% into the inner subpath by a straight line, so the region arrives as
% one keyhole path; the clipper must split it at the close, peel the
% doubled bridge edge, and subtract the opposite-wound inner ring
erasepage
gsave
newpath 32 32 24 0 360 arc closepath
        32 32 12 360 0 arcn closepath
clip
newpath 0 0 moveto 64 0 lineto 64 64 lineto 0 64 lineto closepath fill
grestore
32 14 inkat (ring clip admits the band) assert
14 32 inkat (ring clip admits the band on the other axis) assert
32 32 inkat not (ring clip excludes the hole) assert
32 4 inkat not (ring clip excludes outside the outer circle) assert
} if

% Byte-mapped composite fonts: each mapping hands the declared
% descendant the right code, shown by the descendants' distinct
% advances and by the codes cshow reports
/FmA << /FontType 3 /FontMatrix matrix /FontBBox [0 0 0 0]
  /Encoding 256 array 0 1 255 { 1 index exch /.notdef put } for
  /BuildChar { pop pop 7 0 setcharwidth } bind
>> definefont pop
/FmB << /FontType 3 /FontMatrix matrix /FontBBox [0 0 0 0]
  /Encoding 256 array 0 1 255 { 1 index exch /.notdef put } for
  /BuildChar { pop pop 11 0 setcharwidth } bind
>> definefont pop
/fm.desc [ /FmA findfont /FmB findfont ] def
/fm.w { % string composite . wx
    findfont setfont stringwidth pop
} def
/Fm2 << /FontType 0 /FMapType 2 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<0041 0141> /Fm2 fm.w 18 (an 8/8 code selects by its first byte) assertnear
/Fm4 << /FontType 0 /FMapType 4 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<41 C1> /Fm4 fm.w 18 (a 1/7 code selects by its top bit) assertnear
/Fm5 << /FontType 0 /FMapType 5 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<0041 00C1> /Fm5 fm.w 18 (a 9/7 code selects by its top nine bits) assertnear
/Fm6 << /FontType 0 /FMapType 6 /FontMatrix matrix /SubsVector <003497>
        /Encoding [0 1 0] /FDepVector fm.desc >> definefont pop
<33 41> /Fm6 fm.w 18 (SubsVector codes select by their range) assertnear
<CB> /Fm6 fm.w 7 (a code past every range lands one font beyond) assertnear
% cshow reports the decoded codes with the descendant's widths
/Fm2 findfont setfont
mark { pop exch } <0041 0142> cshow ]
dup length 4 eq
1 index 1 get 65 eq and
1 index 3 get 66 eq and
1 index 0 get 7 sub abs 0.01 lt and
exch 2 get 11 sub abs 0.01 lt and
(cshow reports byte-mapped codes and widths) assert
% the modal mappings: an escape or shift selects for what follows,
% and the selection resets at each show operation
/Fm3 << /FontType 0 /FMapType 3 /FontMatrix matrix /EscChar 255
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<41 FF01 42 43> /Fm3 fm.w 29 (an escape selects for the rest) assertnear
<41 42> /Fm3 fm.w 14 (the selection resets between shows) assertnear
<FF01 41 FF00 42> /Fm3 fm.w 18 (escapes switch back and forth) assertnear
/fm.e300 300 array 0 1 299 { 1 index exch 0 put } for
    dup 257 1 put def
/Fm7 << /FontType 0 /FMapType 7 /FontMatrix matrix /EscChar 255
        /Encoding fm.e300 /FDepVector fm.desc >> definefont pop
<FFFF01 41 42> /Fm7 fm.w 22 (a doubled escape reaches past 255) assertnear
/Fm8 << /FontType 0 /FMapType 8 /FontMatrix matrix
        /Encoding [0 1] /FDepVector fm.desc >> definefont pop
<41 0E 42 43 0F 44> /Fm8 fm.w 36 (shift bytes toggle the two fonts) assertnear
% stringwidth needs no currentpoint of its own
newpath
<41> /Fm4 fm.w 7 (stringwidth measures without a currentpoint) assertnear

% a font dictionary's entries carry the attributes a program reads:
% the matrix is data, the bounding box answers executable as the
% reference interpreters do, and the encoding is data
basefont null ne {
    basefont /FontMatrix get xcheck not
    (a font matrix is literal) assert
    basefont /FontBBox get xcheck
    (a font bounding box is executable) assert
    basefont /Encoding get xcheck not
    (a font encoding is literal) assert
} if

% --- machinery runs a program's procedures on the program's stacks ---
% a callback's defs reach the program's dictionaries, and names the
% machinery uses privately (str, proc, i, pend...) are out of reach:
% defining them in a callback must not corrupt the machinery
/Courier findfont 10 scalefont setfont
gsave
100 100 moveto
{ pop pop /str (mine) def /proc 7 def /iso.k true def } (ab) kshow
grestore
iso.k (a kshow procedure runs on the caller's stacks) assert
str (mine) eq (a kshow procedure's defs reach the caller) assert
userdict /str undef userdict /proc undef userdict /iso.k undef
count /iso.kd exch def
gsave 100 100 moveto { pop pop (k) } (abc) kshow grestore
count iso.kd sub 2 eq (a kshow procedure's stack results survive) assert
pop pop
/iso.c 0 def
gsave 100 100 moveto
{ pop pop pop /iso.c iso.c 1 add def } (ab) cshow
grestore
iso.c 2 eq (a cshow procedure runs per character on the caller's stacks) assert
userdict /iso.c undef
gsave
{ 10 10 8 [10 0 0 -10 0 10]
  { /pend (x) def /rawrow 5 def /got 99 def <00112233445566778899> }
  image } stopped not
(an image source defining the row pump's names completes) assert
grestore
userdict /pend undef userdict /rawrow undef userdict /got undef
gsave
<< /PatternType 1 /PaintType 1 /TilingType 1
   /BBox [0 0 10 10] /XStep 10 /YStep 10
   /PaintProc { pop /i 999 def /pat (mine) def /iso.p true def
                newpath 0 0 moveto 5 0 lineto 5 5 lineto closepath fill }
>> matrix makepattern setpattern
newpath 0 0 moveto 30 0 lineto 30 30 lineto 0 30 lineto closepath fill
grestore
iso.p (a pattern paint procedure runs on the caller's stacks) assert
userdict /i undef userdict /pat undef userdict /iso.p undef

% The TIFF device frames the rgb raster as a baseline TIFF: the
% little-endian header, a directory whose width entry answers, and
% one uncompressed strip of the pixels
/DEVT 8 8 .privatedict /newTIFFIMAGEdevice get exec def
DEVT /OutputFileName (graphics.scratch) put
DEVT /ImgData get .zerorows
1 1 0 2 2 4 4 DEVT dup /FillRect get exec
DEVT dup /Emit get exec
/tf.h (graphics.scratch) (r) file 500 string readstring pop def
tf.h 0 get 16#49 eq tf.h 1 get 16#49 eq and
tf.h 2 get 42 eq and (the TIFF opens little-endian with its magic) assert
% the directory follows the compressed strip at the patched offset
/tf.le4 { % pos . v
    /tf.p exch def 0
    3 -1 0 { tf.p add tf.h exch get exch 256 mul add } for
} def
/tf.ifd 4 tf.le4 def
tf.ifd 8 gt (the directory offset patches past the strip) assert
tf.h tf.ifd 2 add 12 3 mul add get 3 eq
tf.h tf.ifd 2 add 12 3 mul add 1 add get 1 eq and
(the fourth directory entry is the compression tag) assert
tf.h tf.ifd 2 add 12 3 mul add 8 add get 5 eq
(the strip compresses with the shared coder) assert
% decoding the strip recovers the painted pixel
/tf.rt 192 string def
(graphics.scratch) (r) file dup 8 setfileposition
/LZWDecode filter tf.rt readstring pop pop
tf.rt 2 8 mul 2 add 3 mul get 255 eq
tf.rt 2 8 mul 2 add 3 mul 1 add get 255 eq and
tf.rt 2 8 mul 2 add 3 mul 2 add get 0 eq and
(the strip carries the painted pixel) assert

% The distilled-ps device wraps the recorded marks in document
% structure and a prolog naming the accumulated operators
/DEVP 100 100 .privatedict /newDSCWRITEdevice get exec def
DEVP /OutputFileName (graphics.scratch) put
0.5 10 10 30 20 DEVP dup /FillRect get exec
DEVP dup /Emit get exec
/pw.s (graphics.scratch) (r) file 4096 string readstring pop def
pw.s (%!PS-Adobe-3.0) anchorsearch { pop pop true }{ pop false } ifelse
(the distilled page opens with its DSC header) assert
pw.s (re\nf\n) search { pop pop pop true }{ pop false } ifelse
(the recorded rectangle reaches the page) assert
pw.s (%%EOF) search { pop pop pop true }{ pop false } ifelse
(the distilled page closes with its trailer) assert
DEVP dup /Destroy get exec

% The vector writers take whole sampled images: the pdf device files
% an image object the page references, and the svg device embeds the
% bitmap as a data URI; both leave the masked forms to the painters
/DEVV 100 100 .privatedict /newPDFWRITEdevice get exec def
DEVV /OutputFileName (graphics.scratch) put
graphicsdict /currgstate get /device DEVV put
matrix setmatrix
gsave 10 10 translate 40 40 scale
<< /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1]
   /DataSource <11 55 aa ee> >> image
grestore
DEVV dup /Emit get exec
/vw.s (graphics.scratch) (r) file 4096 string readstring pop def
vw.s (%PDF-1.4) anchorsearch { pop pop true }{ pop false } ifelse
(the pdf page opens with its header) assert
vw.s (/Subtype /Image) search { pop pop pop true }{ pop false } ifelse
(the sampled image files as an image object) assert
vw.s (/XObject) search { pop pop pop true }{ pop false } ifelse
(the page resources reference the image) assert
DEVV dup /Destroy get exec
/DEVW 100 100 .privatedict /newSVGWRITEdevice get exec def
DEVW /OutputFileName (graphics.scratch) put
graphicsdict /currgstate get /device DEVW put
matrix setmatrix
gsave 10 10 translate 40 40 scale
<< /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1]
   /DataSource <11 55 aa ee> >> image
grestore
DEVW dup /Emit get exec
/vw.s (graphics.scratch) (r) file 4096 string readstring pop def
vw.s (data:image/bmp;base64,) search { pop pop pop true }{ pop false } ifelse
(the svg page embeds the bitmap as a data URI) assert
DEVW dup /Destroy get exec
graphicsdict /currgstate get /device DEV put
initgraphics

count 0 eq (operand stack is balanced) assert
faildict /n get 0 eq { (SUCCESS\n) print } { faildict /n get =print ( failures\n) print } ifelse
flush
quit
