% The clip region: what a program may do to it, and what the machinery
% says about it. Run through `xpost -d null` by run-ps-test.sh: prints
% SUCCESS iff every assertion holds.
%
% The clip is one value with several faces -- the resolved region the
% painters intersect against, and the path shape a device that clips for
% itself is handed. The faces have to agree, and neither of them may be
% reachable for a program to write.

/faildict 2 dict def
faildict /n 0 put
/assert { % bool (name) . -
    exch { pop } {
        (FAIL: ) print print (\n) print
        faildict /n 2 copy get 1 add put
    } ifelse
} bind def
/assertnear { % val expected (name) . -
    3 1 roll sub abs 0.01 lt exch assert
} bind def

% --- the region is handed out by value, not by reference ---------------
% clippath replaces the current path with the clip region's boundary.
% Appending to a path writes into its storage while there is room and
% moves to fresh storage only when it runs out, so a path built on from
% here reaches into the live clip -- or does not, according to how much
% spare room the region's storage happened to have.

initgraphics
newpath 100 100 moveto 200 100 lineto 200 200 lineto 100 200 lineto
closepath clip

clippath pathbbox
/by1 exch def /bx1 exch def /by0 exch def /bx0 exch def
bx0 100 (clippath reports the clip's left edge) assertnear
by0 100 (clippath reports the clip's bottom edge) assertnear
bx1 200 (clippath reports the clip's right edge) assertnear
by1 200 (clippath reports the clip's top edge) assertnear

% build on the path clippath handed over
500 500 lineto

clippath pathbbox
/ay1 exch def /ax1 exch def /ay0 exch def /ax0 exch def
ax0 bx0 (the clip's left edge survives a path built on clippath) assertnear
ay0 by0 (the clip's bottom edge survives a path built on clippath) assertnear
ax1 bx1 (the clip's right edge survives a path built on clippath) assertnear
ay1 by1 (the clip's top edge survives a path built on clippath) assertnear

% --- the clip stack is pushed and popped, not published ---------------
% clipsave and cliprestore each take no operands and return no results
% (PLRM 8.2). An operator that leaves its own workings on the operand
% stack costs its caller nothing until the caller reads one item too far,
% and then the mistake is charged to whatever reads it.

newpath
clear clipsave
count 0 eq (clipsave returns nothing) assert
clear cliprestore
count 0 eq (cliprestore returns nothing) assert
clear clipsave clipsave cliprestore cliprestore
count 0 eq (a run of clip stack operations returns nothing) assert
clear

% --- the shape a device is handed is the clip that is in force ---------
% A device that clips for itself (ClipPath) is given the clip as a path
% rather than having the fill cut to pixel-band spans first. What it is
% given has to be the clip the painters are enforcing: a device told an
% older shape writes that shape into its output, which no raster render
% of the same page shows.
%
% The device below records nothing but the answer to that question. It
% is asked on every call, so a shape handed over by any route is held to
% it, and a counter says how many times the question was actually put --
% a run in which no device was ever told anything would otherwise pass
% by never being asked.

/.fillpoly     1183615869 internaldict /.fillpoly get def
/.fillrectgray 1183615869 internaldict /.fillrectgray get def

/DEV 300 300 .privatedict /newPGMIMAGEdevice get exec def
DEV begin
    /defaultmatrix [ 1 0 0 -1 0 300 ] def
    /FillPoly /.fillpoly load def
    /FillRect /.fillrectgray load def
    /clipcalls 0 def
    /clipagreed true def

    % path IMAGE  .  -   ; adopt a clip shape
    /ClipPath {
    begin
        /clipcalls clipcalls 1 add def
        % the path walker and pathbbox read the current path, so stand
        % the shape in for the measurement and put the working path back
        graphicsdict /currgstate get /currpath get
        exch
        graphicsdict /currgstate get exch /currpath exch put
        pathbbox
        /gy1 exch def /gx1 exch def /gy0 exch def /gx0 exch def
        graphicsdict /currgstate get exch /currpath exch put
        % the region the painters would enforce
        gsave clippath pathbbox grestore
        /ry1 exch def /rx1 exch def /ry0 exch def /rx0 exch def
        gx0 rx0 sub abs 0.01 lt
        gy0 ry0 sub abs 0.01 lt and
        gx1 rx1 sub abs 0.01 lt and
        gy1 ry1 sub abs 0.01 lt and
        not { /clipagreed false def } if
    end } bind def

    % gray IMAGE  .  -   ; take the whole path
    /FillPath {
    begin
        /pathfills pathfills 1 add def
    end
        pop
    } bind def
    /pathfills 0 def
end
.privatedict /.gstatetemplate get exec /device DEV put
graphicsdict /currgstate get /device DEV put

% a path reaching outside whatever region is in force, so the fill never
% takes the trivial-clip route and the question is always put
/wide { newpath -50 -50 moveto 350 -50 lineto 350 350 lineto -50 350 lineto
        closepath } bind def
/boxpath { % x0 y0 x1 y1  .  -
    4 dict begin
    /cy1 exch def /cx1 exch def /cy0 exch def /cx0 exch def
    newpath
    cx0 cy0 moveto cx1 cy0 lineto cx1 cy1 lineto cx0 cy1 lineto closepath
    end
} bind def

% the control: a clip taken from the whole page is a single path, and a
% fill under it hands the device that path
initgraphics
20 20 280 280 boxpath clip
wide 0 setgray fill
DEV /clipcalls get 0 gt (a fill under a path clip asks the device to clip) assert
DEV /clipagreed get (the control clip is the region in force) assert

% initclip: the region becomes the whole page and the shape must follow
initgraphics
20 20 280 280 boxpath clip
initclip
DEV /clipcalls 0 put
DEV /clipagreed true put
wide 0 setgray fill
DEV /clipagreed get (initclip leaves no older shape behind) assert

% eoclip: the region becomes the even-odd interior, which is resolved to
% pixel-band spans and is no single path a nonzero clip could carry
initgraphics
20 20 280 280 boxpath clip
100 100 150 150 boxpath eoclip
DEV /clipcalls 0 put
DEV /clipagreed true put
wide 0 setgray fill
DEV /clipagreed get (eoclip leaves no older shape behind) assert

% cliprestore: the region goes back to what clipsave took down, and so
% must the shape
initgraphics
clipsave
20 20 280 280 boxpath clip
cliprestore
DEV /clipcalls 0 put
DEV /clipagreed true put
wide 0 setgray fill
DEV /clipagreed get (cliprestore leaves no older shape behind) assert

% --- what is cached about the clip belongs to the clip ----------------
% The resolved form of the region is worked out once and kept, because
% every mark painted under a clip is met against the same region. What
% is kept therefore has to belong to the region and not to the moment: a
% clip taken inside a gsave, or a graphics state set from one taken
% earlier, has to leave the outer clip's answer where it was.
%
% A region resolved to pixel-band spans is used throughout, since that is
% the route the resolved form is kept for; a rectangular region takes the
% shape route instead and would leave the question unasked.

/DEV2 300 300 .privatedict /newPGMIMAGEdevice get exec def
DEV2 begin
    /defaultmatrix [ 1 0 0 -1 0 300 ] def
    /FillPoly /.fillpoly load def
    /FillRect /.fillrectgray load def
end
.privatedict /.gstatetemplate get exec /device DEV2 put
graphicsdict /currgstate get /device DEV2 put
initgraphics

/inkat { % ux uy  .  bool
    transform floor cvi exch floor cvi exch
    DEV2 dup /GetPix get exec 128 lt
} bind def

% a clip inside a gsave, and the clip that comes back after it
initgraphics erasepage
100 100 200 200 boxpath eoclip
gsave
    120 120 140 140 boxpath eoclip
    wide 0 setgray fill
grestore
erasepage
wide 0 setgray fill
105 105 inkat (a fill after grestore reaches the restored clip) assert
250 250 inkat not (a fill after grestore stays inside the restored clip) assert

% and the clip a graphics state carries, set again after another was taken
initgraphics erasepage
100 100 200 200 boxpath eoclip
/gsouter gstate currentgstate def
120 120 140 140 boxpath eoclip
wide 0 setgray fill
gsouter setgstate
erasepage
wide 0 setgray fill
105 105 inkat (a fill after setgstate reaches that state's clip) assert
250 250 inkat not (a fill after setgstate stays inside that state's clip) assert

% and the clip inside the gsave is the one that was asked for
initgraphics erasepage
100 100 200 200 boxpath eoclip
gsave
    120 120 140 140 boxpath eoclip
    wide 0 setgray fill
    125 125 inkat (a fill inside the gsave reaches its own clip) assert
    105 105 inkat not (a fill inside the gsave stays inside its own clip) assert
grestore

% --- a region painted in pieces covers what one fill covers -----------
% The rule two device regions meet by is stated at .regionmeet, and this
% is the case that settles a boundary question about it. A tiling pattern
% paints its region as a clip and then meets every cell against it, so
% the pixels it ends up marking are the region intersection's answer
% several times over; a solid fill of the same path meets nothing and
% marks the pixels PLRM 7.5.1 asks for directly. The two have to agree,
% and the coordinates below are deliberately fractional, since a rule
% that snapped where it should not would agree everywhere else.

/.fillpoly     1183615869 internaldict /.fillpoly get def
/DEV3 96 96 .privatedict /newPGMIMAGEdevice get exec def
DEV3 begin
    /defaultmatrix [ 1 0 0 -1 0 96 ] def
    /FillPoly /.fillpoly load def
    /FillRect /.fillrectgray load def
end
.privatedict /.gstatetemplate get exec /device DEV3 put
graphicsdict /currgstate get /device DEV3 put

/snapshot { % -  .  string   (one byte per pixel, 1 where inked)
    9216 string
    0 1 95 { /sy exch def
        0 1 95 { /sx exch def
            dup sy 96 mul sx add
            sx sy DEV3 dup /GetPix get exec 128 lt { 1 }{ 0 } ifelse
            put
        } for
    } for
} bind def
/inkcount { % string  .  n
    0 exch { add } forall
} bind def

/shapes {
    newpath 10.3 12.7 moveto 70.4 12.7 lineto
            70.4 60.2 lineto 10.3 60.2 lineto closepath fill
    newpath 20 65 moveto 85.6 72.25 lineto 45.5 92.9 lineto closepath fill
} bind def

initgraphics erasepage
0 setgray shapes
/solidink snapshot def

initgraphics erasepage
<< /PatternType 1 /PaintType 1 /TilingType 1
   /BBox [0 0 8 8] /XStep 8 /YStep 8
   /PaintProc { begin 0 setgray 0 0 8 8 rectfill end } >>
matrix makepattern
/Pattern setcolorspace setcolor
shapes
/pattink snapshot def

solidink inkcount 0 gt (the solid fill marked something) assert
solidink pattink eq
    (a pattern fill covers the pixels a solid fill of the same path covers)
    assert

% and again on edges that meet no pixel boundary anywhere. A slanted
% edge crosses a pixel column part way, so which columns it reaches and
% how much of each it covers are different questions, and PLRM 7.5.1
% answers in columns: the clipping region is a set of pixels and what a
% painting operation marks is the intersection of two such sets. Meeting
% the real extents instead loses the columns two regions both reach
% without their extents overlapping inside one -- a pixel each of them
% covers part of, which a fill of either marks. The rectangle above has
% its edges on the grid in one axis and would not ask the question.
%
% The rotation is also what makes the answer stay put: the region goes
% back out as a polygon and its vertices are quantized to the device
% grid when it is read again, so a boundary that is not already on a
% pixel edge can move to the next column on the way through.

/slant {
    matrix currentmatrix
    48 48 translate 15 rotate
    newpath -34 -25 moveto 68 0 rlineto 0 50 rlineto -68 0 rlineto closepath
    setmatrix
} bind def

initgraphics erasepage
0 setgray slant fill
/slantink snapshot def

initgraphics erasepage
<< /PatternType 1 /PaintType 1 /TilingType 1
   /BBox [0 0 8 8] /XStep 8 /YStep 8
   /PaintProc { begin 0 setgray 0 0 8 8 rectfill end } >>
matrix makepattern
/Pattern setcolorspace setcolor
slant fill
/slantpatt snapshot def

slantink inkcount 0 gt (the slanted solid fill marked something) assert
slantink slantpatt eq
    (a pattern fill covers a slanted edge's pixels too) assert

% the same rule reached without the pattern machinery in front of it:
% painting the whole device under a clip set to the shape marks the
% pixels a fill of the shape marks, since the clip's pixels are all of
% them
initgraphics erasepage
slant clip
newpath 0 0 moveto 96 0 lineto 96 96 lineto 0 96 lineto closepath
0 setgray fill
/slantclip snapshot def

slantclip inkcount 0 gt (the fill under the slanted clip marked something) assert
slantink slantclip eq
    (a fill under a clip covers the pixels a fill of the clip's own shape covers)
    assert

% --- what a fill under a clip marks, stated as the rule --------------
% "the clipping region consists of the set of pixels that would be
% included by a fill operation. Subsequent painting operations affect a
% region that is the intersection of the set of pixels defined by the
% clipping region with the set of pixels for the region to be painted"
% (PLRM 7.5.1). Both sides are sets of pixels, so the answer is the
% intersection of two sets that can each be measured on their own: fill
% the clip's shape, fill the subject, and require the clipped fill to
% mark exactly the pixels both marked.
%
% The two shapes below meet in one pixel column and nowhere else -- the
% clip stops at 20.2 and the subject starts at 20.5, both inside column
% 20 -- so the whole answer rides on the rule rather than on where a
% rounding happened to land. Meeting the real extents finds nothing
% there; meeting the pixels finds the column both shapes cover part of,
% and which a fill of either marks whole.
%
% eoclip resolves its region to pixel-band spans, which is the route a
% region of any shape takes; a rectangular region goes through the
% half-plane clipper in clip.ps instead, which answers about shape and
% says so.

/andink { % a b  .  string   (the pixels in both)
    /ai.b exch def /ai.a exch def
    ai.a length string
    0 1 ai.a length 1 sub {
        /ai.i exch def
        dup ai.i ai.a ai.i get ai.b ai.i get mul put
    } for
} bind def

/nearclipshape { newpath 10 10 moveto 20.2 10 lineto
                         20.2 40 lineto 10 40 lineto closepath } bind def
/nearfillshape { newpath 20.5 15 moveto 60 15 lineto
                         60 35 lineto 20.5 35 lineto closepath } bind def

initgraphics erasepage 0 setgray nearclipshape fill
/nearclipink snapshot def
initgraphics erasepage 0 setgray nearfillshape fill
/nearfillink snapshot def
initgraphics erasepage nearclipshape eoclip 0 setgray nearfillshape fill
/nearbothink snapshot def

nearclipink nearfillink andink /nearwant exch def
nearwant inkcount 0 gt
    (the clip and the subject share pixels to ask about) assert
nearbothink nearwant eq
    (a fill under a clip marks the pixels the clip and the subject both cover)
    assert

% --- a region divided into more bands than one array describes --------
% A painter meets the clipping region as a set of pixel bands and reads
% the bands out of an array. A band costs five array elements and an
% array's length is a bounded field, so a page painted under a comb or a
% stipple has an answer no single array states: fifty teeth over three
% hundred rows are fifteen thousand bands and seventy-five thousand
% elements, where the field runs out around thirteen thousand bands.
%
% That is a bound on the description and not on the painting. PLRM 7.5.1
% makes what any painting operation marks the intersection of the pixels
% it would cover with the pixels of the region, and the intersection is
% the same set however many arrays it takes to state it: the answer is
% cut into tiles of rows until each tile fits one.
%
% Every painter that meets a region is asked the comb, and each is held
% to the pixels rather than to the absence of a complaint. A painter
% that fell back on the region's bounding box would mark twice as many,
% and one that dropped a tile would mark fewer. The bands are counted at
% the device as well: tiles that described a row twice would send more
% than the fifteen thousand the region holds, and the page could not say
% so, since a row painted twice in one colour looks like a row painted
% once.

/DEV5 200 300 .privatedict /newPGMIMAGEdevice get exec def
DEV5 begin
    /defaultmatrix [ 1 0 0 -1 0 300 ] def
    /bands 0 def
    % the pixel-band rectangles the painter handed over, counted on the
    % way through to the fill that marks them
    /FillPoly {                         % mark comps... poly devdic  .  devdic
        dup begin
            exch dup
            0 exch { null eq { 1 add } if } forall
            /bands exch bands add def
            exch
        end
        .fillpoly
    } bind def
    /FillRect /.fillrectgray load def
end
.privatedict /.gstatetemplate get exec /device DEV5 put
graphicsdict /currgstate get /device DEV5 put

% a comb of vertical bars `bar` wide every `step` columns, taken as the
% clip region
/combclip { % bar step  .  -
    4 dict begin
    /step exch def /bar exch def
    newpath
    0 step 200 step sub {
        /cx exch def
        cx 0 moveto cx bar add 0 lineto
        cx bar add 300 lineto cx 300 lineto closepath
    } for
    clip newpath
    end
} bind def

% what the page carries: how many pixels are marked, and how many of
% those lie outside the teeth of the comb the region was cut from
/tally { % bar step  .  marked strayed
    8 dict begin
    /step exch def /bar exch def
    /marked 0 def /strayed 0 def
    /rows DEV5 /ImgData get def
    0 1 rows length 1 sub {
        /ty exch def
        /row rows ty get def
        0 1 row length 1 sub {
            /tx exch def
            row tx get 128 lt {
                /marked marked 1 add def
                tx step mod bar ge { /strayed strayed 1 add def } if
            } if
        } for
    } for
    marked strayed
    end
} bind def

/wholepage { newpath -1 -1 moveto 201 -1 lineto
             201 301 lineto -1 301 lineto closepath } bind def

initgraphics erasepage 2 4 combclip
DEV5 /bands 0 put
0 setgray wholepage fill
2 4 tally
0 eq (a fill under a fifty-tooth comb stays inside the teeth) assert
30000 eq (a fill under a fifty-tooth comb marks every pixel of them) assert
DEV5 /bands get 15000 eq
    (the fill sends the fifteen thousand bands the region holds, once each)
    assert

initgraphics erasepage 2 4 combclip
0 setgray wholepage eofill
2 4 tally
0 eq (an eofill under the comb stays inside the teeth) assert
30000 eq (an eofill under the comb marks every pixel of them) assert

initgraphics erasepage 2 4 combclip
0 setgray -1 -1 202 302 rectfill
2 4 tally
0 eq (a rectfill under the comb stays inside the teeth) assert
30000 eq (a rectfill under the comb marks every pixel of them) assert

% the image route writes rows straight into the raster and clamps each
% write against the region's own spans, so it meets the comb by a road
% of its own
initgraphics erasepage 2 4 combclip
gsave
    200 0 0 300 0 0 6 array astore concat
    << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
       /Decode [0 1] /ImageMatrix [2 0 0 -2 0 2]
       /DataSource <00000000> >> image
grestore
2 4 tally
0 eq (an image under the comb stays inside the teeth) assert
30000 eq (an image under the comb marks every pixel of them) assert

initgraphics erasepage 2 4 combclip
gsave
    0 setgray
    200 0 0 300 0 0 6 array astore concat
    << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 1
       /Decode [0 1] /ImageMatrix [2 0 0 -2 0 2]
       /DataSource <0000> >> imagemask
grestore
2 4 tally
0 eq (an imagemask under the comb stays inside the teeth) assert
30000 eq (an imagemask under the comb marks every pixel of them) assert

% twice as fine again: a hundred teeth over the same rows are thirty
% thousand bands, which one halving of the page still cannot hold, so
% the cutting has to go on until it can
initgraphics erasepage 1 2 combclip
DEV5 /bands 0 put
0 setgray wholepage fill
1 2 tally
0 eq (a fill under a hundred-tooth comb stays inside the teeth) assert
30000 eq (a fill under a hundred-tooth comb marks every pixel of them) assert
DEV5 /bands get 30000 eq
    (the finer fill sends the thirty thousand bands the region holds, once each)
    assert

% and a subject reaching part of the way down it: what a painter marks
% is bounded by the subject as well as by the region, and the tiles are
% cut out of the rows the subject reaches
initgraphics erasepage 2 4 combclip
0 setgray newpath -1 100 moveto 201 100 lineto
          201 200 lineto -1 200 lineto closepath fill
2 4 tally
0 eq (a fill of part of the page under the comb stays inside the teeth) assert
10000 eq (a fill of part of the page under the comb marks that part of them)
    assert

% the control: a page fill under a region a single array holds easily
% marks that region and nothing more, and is handed over as the one
% rectangle it is -- so what is asserted above is a region divided too
% finely for one array and not a painter that has stopped meeting one
initgraphics erasepage
newpath 40 50 moveto 160 50 lineto 160 250 lineto 40 250 lineto closepath
clip newpath
DEV5 /bands 0 put
0 setgray wholepage fill
200 200 tally pop
24000 eq (a fill under a rectangular region marks the region's pixels) assert
DEV5 /bands get 1 eq
    (a fill under a rectangular region is handed over as one rectangle) assert

% --- clipsave's depth limit is the exhaustion PLRM 8.2 names for it ---
% The stack is a fixed depth. Running past it is the operator running out
% of storage, not a bad index handed to it, and a program that catches the
% one and not the other has to be told which.
gsave
    newpath 100 100 200 200 rectclip
    { 32 { clipsave } repeat 32 { cliprestore } repeat } stopped not
        (thirty-two nested clipsaves are accepted and pair off) assert
    { 40 { clipsave } repeat } stopped
        { $error /errorname get /limitcheck eq }{ false } ifelse
        (running past the depth reports limitcheck) assert
    % an operator that fails leaves nothing behind, and what it was
    % holding is the machinery's own clip stack: a program left with it
    % could read a saved clip and write the slot a cliprestore installs
    count 0 eq (the refused clipsave leaves the operand stack alone) assert
    clear
grestore
initclip

count 0 eq (the suite leaves the operand stack empty) assert
faildict /n get 0 eq { (SUCCESS) = }{ (FAILURES: ) print faildict /n get = } ifelse
quit
