%!testlib
% The virtual-memory parameter operators (PLRM 8.2), run through
% `xpost -q --no-sandbox -d null` by run-ps-test.sh.
%
% vmstatus reports the save level and the memory consumed and available.
% Virtual memory is accounted for separately in each bank, and the two
% counts are of the bank the allocation mode selects (PLRM 8.2, vmstatus:
% "the used and maximum values apply to either local or global VM
% according to the current VM allocation mode"), while the level is the
% depth of save nesting, which a program has one of. globalvmstatus
% answers the same three numbers for global memory whatever the mode.
%
% vmreclaim controls the collector and answers rangecheck outside the five
% values it defines.

/isint { type /integertype eq } def

% --- vmstatus answers three integers ---
clear
vmstatus
count 3 eq (vmstatus answers three values) assert
/vmmax exch def /vmused exch def /vmlevel exch def
vmmax isint vmused isint and vmlevel isint and
    (vmstatus answers integers) assert
vmused 0 gt (vmstatus reports memory in use) assert
vmused vmmax le (the memory in use is within the maximum) assert

% --- the level vmstatus reports is the save level ---
clear
vmstatus pop pop /level0 exch def
save
vmstatus pop pop /level1 exch def
level1 level0 gt (save raises the level vmstatus reports) assert
restore
vmstatus pop pop /level2 exch def
level2 level0 eq (restore returns the level vmstatus reports) assert

% --- globalvmstatus answers three integers for global memory alone ---
clear
globalvmstatus
count 3 eq (globalvmstatus answers three values) assert
/gmax exch def /gused exch def /glevel exch def
gmax isint gused isint and glevel isint and
    (globalvmstatus answers integers) assert
gused 0 gt (globalvmstatus reports memory in use) assert
gused gmax le (the global memory in use is within its maximum) assert
% --- the two counts follow the allocation mode ---
% Asked in global mode, vmstatus answers for the same bank
% globalvmstatus does; asked in local mode it answers for the other. The
% two are compared with room for what the calls themselves allocate, and
% against each other to show they are not one number answering for both.
clear
currentglobal
true setglobal
vmstatus pop /gmodeused exch def pop
false setglobal
vmstatus pop /lmodeused exch def pop
setglobal
globalvmstatus pop /gbankused exch def pop
gmodeused gbankused sub abs 65536 lt
    (in global mode vmstatus counts the global bank) assert
lmodeused gmodeused ne
    (the mode chooses which bank is counted) assert
lmodeused gbankused sub abs 65536 ge
    (in local mode vmstatus does not count the global bank) assert

% --- vmreclaim takes the five values it defines, and no others ---
clear
{ -2 vmreclaim } (vmreclaim disables collection in both banks) works
{ -1 vmreclaim } (vmreclaim disables collection in local memory) works
{ 0 vmreclaim } (vmreclaim enables collection) works
{ 1 vmreclaim } (vmreclaim collects local memory) works
{ 2 vmreclaim } (vmreclaim collects both banks) works
clear

% anything outside that range is a rangecheck, and a non-integer a typecheck
{ 3 vmreclaim } /rangecheck (a value above the range is refused) raises
{ -3 vmreclaim } /rangecheck (a value below the range is refused) raises
{ (x) vmreclaim } /typecheck (a non-integer operand is refused) raises

% --- an immediate collection leaves the program running over it ---
% the collector reclaims what nothing reaches; everything the program can
% still name must survive it
clear
/keep [ 1 2 3 ] def
/keepstr (survivor) def
20 { 100 array pop } repeat        % garbage for the collection to find
1 vmreclaim
keep length 3 eq (an array survives a collection) assert
keep 2 get 3 eq (its contents survive a collection) assert
keepstr (survivor) eq (a string survives a collection) assert
0 vmreclaim
clear

verdict
