% Arithmetic/math operator compliance (PLRM 8.2), run through `xpost -d null` by
% run-ps-test.sh: prints SUCCESS iff every assertion holds.
%
%   - mod or idiv by a zero divisor is undefinedresult (PLRM), as is INT_MIN
%     mod/idiv -1
%   - sqrt of a negative operand is rangecheck
%   - RAD_PER_DEG is M_PI/180, so atan/sin/cos hit the PLRM examples
%   - bitshift moves a bit pattern: the fill is 0 both ways and a count
%     that reaches the integer's width leaves nothing

/failcount 0 def
/assert { exch { pop } { (FAIL: ) print print (\n) print /failcount failcount 1 add store } ifelse } def
/assertnear { 3 1 roll sub abs 1e-4 lt exch assert } def
/erris { % { proc } /name (tag)  -> asserts proc raises error /name
    3 dict begin
    /tag exch def /want exch def
    stopped { $error /errorname get want eq }{ false } ifelse
    tag assert clear  % PLRM restores the failed operator's operands; drop them
    end
} def

% --- mod / idiv / div: zero divisor is undefinedresult, not a crash ---
{ 7 0 mod } /undefinedresult (mod by zero is undefinedresult) erris
{ 7 0 idiv } /undefinedresult (idiv by zero is undefinedresult) erris
{ 1 0 div } /undefinedresult (div by zero is undefinedresult) erris
% surviving these proves no SIGFPE took the interpreter down
(reached: interpreter survived the zero divisions) =

% --- INT_MIN edge: no overflow fault ---
{ -2147483648 -1 mod cvi } stopped { pop false }{ 0 eq } ifelse
    (INT_MIN mod -1 is 0, no fault) assert
{ -2147483648 -1 idiv } stopped { pop false }{ pop true } ifelse
    (INT_MIN idiv -1 yields a value, no fault) assert

% --- mod sign follows the dividend (PLRM examples) ---
5 3 mod 2 eq (5 3 mod = 2) assert
5 2 mod 1 eq (5 2 mod = 1) assert
-5 3 mod -2 eq (-5 3 mod = -2) assert

% --- idiv truncates toward zero ---
3 2 idiv 1 eq (3 2 idiv = 1) assert
-5 2 idiv -2 eq (-5 2 idiv = -2) assert

% --- div always real ---
4 2 div 2.0 eq (4 2 div = 2.0 real) assert

% --- sqrt: negative is rangecheck ---
{ -1 sqrt } /rangecheck (sqrt of negative is rangecheck) erris
16 sqrt 4.0 eq (sqrt 16 = 4) assert

% --- round: ties go to the greater value (PLRM) ---
3.2 round 3.0 eq (round 3.2 = 3) assert
6.5 round 7.0 eq (round 6.5 = 7) assert
-4.8 round -5.0 eq (round -4.8 = -5) assert
-6.5 round -6.0 eq (round -6.5 = -6, greater of -7/-6) assert
99 round 99 eq (round of an integer stays integer-valued) assert

% --- ceiling / floor / truncate ---
3.2 ceiling 4.0 eq (ceiling 3.2 = 4) assert
3.7 floor 3.0 eq (floor 3.7 = 3) assert
-3.7 truncate -3.0 eq (truncate -3.7 = -3) assert

% --- atan (degrees 0..360), the PLRM examples exactly ---
0 1 atan 0.0 (0 1 atan = 0) assertnear
1 0 atan 90.0 (1 0 atan = 90) assertnear
-100 0 atan 270.0 (-100 0 atan = 270) assertnear
1 1 atan 45.0 (1 1 atan = 45) assertnear

% --- sin / cos in degrees ---
0 cos 1.0 (cos 0 = 1) assertnear
90 sin 1.0 (sin 90 = 1) assertnear
30 sin 0.5 (sin 30 = 0.5) assertnear
60 cos 0.5 (cos 60 = 0.5) assertnear

% --- exp / ln / log ---
2 3 exp 8.0 (2 3 exp = 8) assertnear
1 ln 0.0 (ln 1 = 0) assertnear
1000 log 3.0 (log 1000 = 3) assertnear

% --- integer add overflowing to real (value; representation is impl-defined) ---
2000000000 2000000000 add 4.0e9 (int add overflow -> real) assertnear

% --- bitshift moves a bit pattern, not a value ---
% PLRM 8.2: bitshift "shifts the binary representation of int1", bits
% shifted out are lost and bits shifted in are 0. So the operand is its
% two's-complement pattern rather than its magnitude, the fill is 0 in
% both directions, and a count that reaches the integer's width has
% carried every bit out. What that width is belongs to the object width
% and is asked in build_personality_test.ps; everything below holds
% whichever width the build has.
7 3 bitshift 56 eq (7 3 bitshift = 56) assert
142 -3 bitshift 17 eq (142 -3 bitshift = 17) assert
-1 0 bitshift -1 eq (a shift of no bits returns the operand) assert
-1 1 bitshift -2 eq (a negative operand shifts as a bit pattern) assert

% A right shift fills with 0 and not with the sign, so a negative
% operand comes back positive. An arithmetic shift would hand back a
% negative value here whatever the width.
-1 -1 bitshift 0 gt (a right shift fills a negative operand with zeros) assert
-2 -1 bitshift 0 gt (a right shift of any negative operand is positive) assert

% Counts past any width: every bit is carried out, leaving nothing. The
% last is the most negative count there is, which has no positive
% counterpart to be negated into.
1 1000 bitshift 0 eq (a left shift past the width leaves nothing) assert
-1 1000 bitshift 0 eq (a left shift past the width keeps nothing back) assert
1 -1000 bitshift 0 eq (a right shift past the width leaves nothing) assert
-1 -1000 bitshift 0 eq (a right shift past the width keeps nothing back) assert
1 -2147483648 bitshift 0 eq (the most negative count leaves nothing) assert

% --- results land on the operand stack in the same interpreter cycle ---
% A result misrouted to the exec stack only reaches the operand stack a cycle
% later, so an operator immediately following in the same procedure underflows.
% proc  immediateok  bool -- true iff proc runs without error and leaves
% exactly one true on the operand stack
/immediateok {
    mark exch stopped
    { cleartomark false }
    { counttomark 1 eq { true eq exch pop }{ cleartomark false } ifelse } ifelse
} def

{ 100 log 2 mul 4.0 eq } immediateok (log result is consumable in its own procedure) assert
{ 100.0 log 2 mul 4.0 eq } immediateok (log of a real is consumable in its own procedure) assert
{ rand type /integertype eq } immediateok (rand result is consumable in its own procedure) assert
{ rand 0 ge } immediateok (rand yields a nonnegative integer) assert
{ 42 srand rrand 42 eq } immediateok (rrand result is consumable in its own procedure) assert

failcount 0 eq { (SUCCESS) = } { (FAILURES: ) print failcount = } ifelse
